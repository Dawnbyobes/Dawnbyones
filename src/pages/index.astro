---
const title = "冰箱里的世界";
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: "SF Mono", "Fira Code", "JetBrains Mono", "Courier New", monospace;
        background: #0a0a0a;
        color: #e0e0e0;
        line-height: 1.6;
        min-height: 100vh;
      }
      
      .container {
        max-width: 720px;
        margin: 0 auto;
        padding: 0 2rem;
      }
      
      header {
        padding: 2rem 0;
        border-bottom: 1px solid #333;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      
      .logo {
        font-size: 0.875rem;
        font-weight: 400;
        color: #fff;
        letter-spacing: 0.05em;
      }
      
      .logo::before {
        content: ">";
        color: #fff;
        margin-right: 0.5rem;
      }
      
      .nav a {
        color: #888;
        text-decoration: none;
        margin-left: 2rem;
        font-size: 0.8125rem;
        transition: color 0.2s;
      }
      
      .nav a:hover {
        color: #fff;
      }
      
      main {
        padding: 6rem 0;
      }
      
      .hero {
        margin-bottom: 4rem;
      }
      
      .hero h1 {
        font-size: 2rem;
        font-weight: 400;
        color: #fff;
        margin-bottom: 1.5rem;
        letter-spacing: -0.02em;
      }
      
      .hero p {
        font-size: 0.9375rem;
        color: #666;
        line-height: 1.8;
      }
      
      .divider {
        width: 2rem;
        height: 1px;
        background: #333;
        margin: 2rem 0;
      }
      
      .status {
        display: inline-flex;
        align-items: center;
        gap: 0.5rem;
        font-size: 0.8125rem;
        color: #555;
        margin-top: 2rem;
      }
      
      .status::before {
        content: "";
        width: 6px;
        height: 6px;
        background: #fff;
        border-radius: 50%;
      }
      
      .actions {
        margin-top: 4rem;
        display: flex;
        gap: 1rem;
      }
      
      .btn {
        display: inline-flex;
        align-items: center;
        padding: 0.75rem 1.5rem;
        border: 1px solid #333;
        color: #e0e0e0;
        text-decoration: none;
        font-size: 0.8125rem;
        transition: all 0.2s;
      }
      
      .btn:hover {
        border-color: #fff;
        color: #fff;
      }
      
      .btn-primary {
        background: #fff;
        color: #0a0a0a;
        border-color: #fff;
      }
      
      .btn-primary:hover {
        background: #e0e0e0;
        border-color: #e0e0e0;
      }
      
      footer {
        padding: 2rem 0;
        border-top: 1px solid #1a1a1a;
        margin-top: auto;
      }
      
      footer p {
        font-size: 0.75rem;
        color: #333;
      }
    </style>
  </head>
  <body>
    <header class="container">
      <span class="logo">{title}</span>
      <nav class="nav">
        <a href="/login">登录</a>
        <a href="/register">注册</a>
      </nav>
    </header>
    
    <main class="container">
      <div class="hero">
        <h1>冰箱里的世界</h1>
        <p>一个私密的阅读空间。<br>只有持有邀请码的会员才能进入。</p>
        <div class="divider"></div>
        <div class="status">会员邀请制运行中</div>
      </div>
      
      <div class="actions">
        <a href="/register" class="btn btn-primary">使用邀请码注册</a>
        <a href="/login" class="btn">会员登录</a>
      </div>
    </main>
    
    <footer class="container">
      <p>© 2026 {title} · INVITE ONLY</p>
    </footer>
  </body>
</html>