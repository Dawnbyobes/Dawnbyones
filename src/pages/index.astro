---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="冰箱里的世界">
  <Header mode="public" />

  <main class="container">
    <section class="hero">
      <h1>冰箱里的世界</h1>
      <p class="hero-desc">只有受邀者才能进入的小世界</p>
      <div class="hero-actions">
        <a href="/login" class="btn btn-primary">登录</a>
        <a href="/register" class="btn btn-secondary">注册</a>
      </div>
    </section>

    <div class="divider"></div>

    <section class="about">
      <h2 class="section-label">关于</h2>
      <div class="features">
        <div class="feature">
          <h3>纯粹体验</h3>
          <p>私密阅读，只有你和故事</p>
        </div>
        <div class="feature">
          <h3>持续更新</h3>
          <p>作者不定期更新章节</p>
        </div>
        <div class="feature">
          <h3>联系方式</h3>
          <p>不可申请，仅限受邀会员</p>
        </div>
      </div>
    </section>
  </main>

  <footer class="container site-footer">
    <p>2026 冰箱里的世界 · 仅供会员阅读</p>
  </footer>
</Layout>

<style>
  .hero {
    padding: 100px 0 60px;
    text-align: center;
  }
  .hero h1 {
    font-size: 32px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 12px;
  }
  .hero-desc {
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 32px;
    letter-spacing: 0.04em;
  }
  .hero-actions {
    display: flex;
    gap: 12px;
    justify-content: center;
  }

  .about { padding-bottom: 60px; }
  .section-label {
    font-size: 11px;
    font-weight: 500;
    color: var(--text-tertiary);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 32px;
  }
  .features {
    display: flex;
    flex-direction: column;
  }
  .feature {
    padding: 20px 0;
    border-bottom: 1px solid var(--border);
  }
  .feature:last-child { border-bottom: none; }
  .feature h3 {
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 4px;
  }
  .feature p {
    font-size: 14px;
    color: var(--text-secondary);
  }

  @media (max-width: 640px) {
    .hero { padding: 64px 0 40px; }
    .hero h1 { font-size: 26px; }
  }
</style>
