---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const title = "冰箱里的世界";
---

<Layout title={title}>
  <Header mode="public" />
  
  <main>
    <div class="hero container">
      <h1>冰箱里的世界</h1>
      <p>只有受邀者才能进入的小世界。</p>
      <a href="/login" class="btn btn-primary">会员制登录</a>
    </div>
    
    <div class="divider"></div>
    
    <div class="section container">
      <h2>关于本站</h2>
      <div class="feature">
        <h3>纯粹体验</h3>
        <p>私密阅读，只有你和故事。</p>
      </div>
      <div class="feature">
        <h3>持续更新</h3>
        <p>作者不定期更新章节，敬请期待。</p>
      </div>
      <div class="feature">
        <h3>联系方式</h3>
        <p>不可申请，仅限受邀会员。</p>
      </div>
    </div>
  </main>
  
  <footer class="container">
    <p>2026 {title} · 仅供会员阅读</p>
  </footer>
</Layout>

<style>
  .hero {
    text-align: center;
    padding: 10rem 0 6rem;
  }
  
  .hero h1 {
    font-size: 2.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1.5rem;
    letter-spacing: 0.02em;
  }
  
  .hero p {
    font-size: 1rem;
    color: var(--text-dim);
    max-width: 480px;
    margin: 0 auto 3rem;
  }
  
  .section {
    padding: 2rem 0 6rem;
  }
  
  .section h2 {
    font-size: 0.75rem;
    color: var(--text-faint);
    text-transform: uppercase;
    letter-spacing: 0.15em;
    margin-bottom: 2rem;
  }
  
  .feature {
    padding: 1.5rem 0;
    border-bottom: 1px solid var(--border-color);
  }
  
  .feature:last-child {
    border-bottom: none;
  }
  
  .feature h3 {
    font-size: 1.125rem;
    color: var(--text-primary);
    font-weight: 500;
    margin-bottom: 0.5rem;
  }
  
  .feature p {
    font-size: 0.875rem;
    color: var(--text-dim);
  }
  
  footer {
    padding: 3rem 0;
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-faint);
  }
  
  @media (max-width: 640px) {
    .hero {
      padding: 6rem 0 4rem;
    }
    
    .hero h1 {
      font-size: 2rem;
    }
  }
</style>
