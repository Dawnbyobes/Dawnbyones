---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';

const title = "冰箱里的世界";
---

<Layout title={title}>
  <Header mode="public" />

  <main>
    <!-- Hero 区域 -->
    <div class="hero container">
      <div class="hero-glow"></div>
      <h1>冰箱里的世界</h1>
      <p class="hero-desc">只有受邀者才能进入的小世界。</p>
      <a href="/login" class="btn btn-primary hero-btn">会员制登录</a>
    </div>

    <div class="divider"></div>

    <!-- 关于区域 -->
    <div class="section container">
      <h2 class="section-title">关于本站</h2>
      <div class="features">
        <div class="feature">
          <div class="feature-icon">◉</div>
          <div class="feature-content">
            <h3>纯粹体验</h3>
            <p>私密阅读，只有你和故事。</p>
          </div>
        </div>
        <div class="feature">
          <div class="feature-icon">◉</div>
          <div class="feature-content">
            <h3>持续更新</h3>
            <p>作者不定期更新章节，敬请期待。</p>
          </div>
        </div>
        <div class="feature">
          <div class="feature-icon">◉</div>
          <div class="feature-content">
            <h3>联系方式</h3>
            <p>不可申请，仅限受邀会员。</p>
          </div>
        </div>
      </div>
    </div>
  </main>

  <footer class="container">
    <p>2026 {title} · 仅供会员阅读</p>
  </footer>
</Layout>

<style>
  /* Hero */
  .hero {
    text-align: center;
    padding: 10rem 0 6rem;
    position: relative;
  }

  .hero-glow {
    position: absolute;
    top: 50%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.12) 0%, rgba(6, 182, 212, 0.05) 40%, transparent 70%);
    pointer-events: none;
    z-index: 0;
  }

  .hero h1 {
    position: relative;
    z-index: 1;
    font-size: 3rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-light) 50%, var(--cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
    letter-spacing: -0.02em;
  }

  .hero-desc {
    position: relative;
    z-index: 1;
    font-size: 1rem;
    color: var(--text-muted);
    max-width: 480px;
    margin: 0 auto 2.5rem;
    letter-spacing: 0.05em;
  }

  .hero-btn {
    position: relative;
    z-index: 1;
    padding: 1rem 3.5rem;
    font-size: 0.9375rem;
  }

  /* 关于 */
  .section {
    padding: 2rem 0 6rem;
  }

  .section-title {
    font-size: 0.75rem;
    font-weight: 500;
    color: var(--accent-light);
    text-transform: uppercase;
    letter-spacing: 0.2em;
    margin-bottom: 2.5rem;
  }

  .features {
    display: flex;
    flex-direction: column;
    gap: 0;
  }

  .feature {
    display: flex;
    align-items: flex-start;
    gap: 1.25rem;
    padding: 1.75rem 0;
    border-bottom: 1px solid var(--border-color);
    transition: all 0.25s;
  }

  .feature:last-child {
    border-bottom: none;
  }

  .feature:hover {
    padding-left: 0.75rem;
  }

  .feature-icon {
    font-size: 0.625rem;
    color: var(--accent);
    margin-top: 0.5rem;
    flex-shrink: 0;
  }

  .feature-content h3 {
    font-size: 1.125rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0.375rem;
  }

  .feature-content p {
    font-size: 0.875rem;
    color: var(--text-muted);
    line-height: 1.7;
  }

  /* Footer */
  footer {
    padding: 3rem 0;
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-faint);
    letter-spacing: 0.05em;
  }

  @media (max-width: 640px) {
    .hero {
      padding: 6rem 0 4rem;
    }

    .hero h1 {
      font-size: 2.25rem;
    }

    .hero-glow {
      width: 300px;
      height: 300px;
    }
  }
</style>
