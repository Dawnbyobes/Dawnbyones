---
import Layout from '../layouts/Layout.astro';

const inviteCode = Astro.url.searchParams.get('code') || '';
---

<Layout title="注册">
  <div class="auth-page">
    <div class="auth-box">
      <a href="/" class="back-link">返回首页</a>
      <h1>注册</h1>
      <p class="subtitle">输入邀请码，开启阅读</p>

      <form id="registerForm">
        <input type="text" id="inviteCode" placeholder="邀请码" value={inviteCode} required autocomplete="off" />
        <input type="email" id="email" placeholder="邮箱" required autocomplete="email" />
        <input type="password" id="password" placeholder="密码（至少6位）" required minlength="6" autocomplete="new-password" />
        <button type="submit" class="btn btn-primary" id="submitBtn">注册</button>
      </form>

      <div class="message" id="message"></div>

      <div class="auth-links">
        <a href="/login">已有账号？登录</a>
      </div>
    </div>
  </div>
</Layout>

<script type="module">
  import { signUp, checkInviteCode, consumeInviteCode } from '/lib/supabase.js';

  const form = document.getElementById('registerForm');
  const msg = document.getElementById('message');
  const btn = document.getElementById('submitBtn');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = '注册中...';
    msg.innerHTML = '';

    const code = document.getElementById('inviteCode').value.trim().toUpperCase();
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;

    const { valid } = await checkInviteCode(code);
    if (!valid) {
      msg.innerHTML = '<p class="error">邀请码无效或已被使用</p>';
      btn.disabled = false;
      btn.textContent = '注册';
      return;
    }

    const { data: authData, error: authError } = await signUp(email, password);
    if (authError) {
      msg.innerHTML = `<p class="error">${authError.message}</p>`;
      btn.disabled = false;
      btn.textContent = '注册';
      return;
    }

    await consumeInviteCode(code, email);
    if (authData.session) localStorage.setItem('sb_token', authData.session.access_token);
    msg.innerHTML = '<p class="success">注册成功，正在跳转...</p>';
    setTimeout(() => window.location.href = '/login', 1200);
  });
</script>

<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .auth-box {
    width: 100%;
    max-width: 360px;
  }
  .back-link {
    display: block;
    color: var(--text-tertiary);
    text-decoration: none;
    font-size: 13px;
    margin-bottom: 40px;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--text); }
  h1 {
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 4px;
    letter-spacing: -0.01em;
  }
  .subtitle {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 32px;
  }
  form input {
    margin-bottom: 10px;
  }
  form .btn {
    width: 100%;
    margin-top: 6px;
  }
  .auth-links {
    margin-top: 24px;
    font-size: 13px;
    text-align: center;
  }
  .auth-links a {
    color: var(--text-tertiary);
    text-decoration: none;
    transition: color 0.2s;
  }
  .auth-links a:hover { color: var(--text); }
</style>
