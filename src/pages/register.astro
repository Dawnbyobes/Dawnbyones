---
import Layout from '../layouts/Layout.astro';

const inviteCode = Astro.url.searchParams.get('code') || '';
---

<Layout title="注册 - 冰箱里的世界">
  <div class="auth-page">
    <div class="auth-glow"></div>
    <div class="auth-glow-secondary"></div>
    <div class="auth-box animate-fade-in-up">
      <a href="/" class="back-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.375rem;">
          <line x1="19" y1="12" x2="5" y2="12"/>
          <polyline points="12 19 5 12 12 5"/>
        </svg>
        返回首页
      </a>

      <div class="auth-header">
        <div class="auth-logo">
          <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M16 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2"/>
            <circle cx="8.5" cy="7" r="4"/>
            <line x1="20" y1="8" x2="20" y2="14"/>
            <line x1="23" y1="11" x2="17" y2="11"/>
          </svg>
        </div>
        <h1>会员注册</h1>
        <p class="subtitle">输入邀请码，开启阅读之旅</p>
      </div>

      <form id="registerForm">
        <div class="form-group">
          <label for="inviteCode">邀请码</label>
          <input type="text" id="inviteCode" placeholder="输入邀请码" value={inviteCode} required autocomplete="off" />
        </div>
        <div class="form-group">
          <label for="email">邮箱</label>
          <input type="email" id="email" placeholder="your@email.com" required autocomplete="email" />
        </div>
        <div class="form-group">
          <label for="password">密码</label>
          <input type="password" id="password" placeholder="至少6位字符" required minlength="6" autocomplete="new-password" />
          <span class="input-hint">密码长度至少为6个字符</span>
        </div>
        <button type="submit" class="btn btn-primary submit-btn" id="submitBtn">
          <span class="btn-text">注册</span>
        </button>
      </form>

      <div class="message" id="message"></div>

      <div class="auth-links">
        <a href="/login" class="auth-link">已有账号？直接登录</a>
      </div>
    </div>
  </div>
</Layout>

<script type="module">
  import { signUp, checkInviteCode, consumeInviteCode } from '/lib/supabase.js';

  const form = document.getElementById('registerForm');
  const msg = document.getElementById('message');
  const btn = document.getElementById('submitBtn');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.querySelector('.btn-text').textContent = '注册中...';
    msg.innerHTML = '';

    const code = document.getElementById('inviteCode').value.trim().toUpperCase();
    const email = document.getElementById('email').value.trim();
    const password = document.getElementById('password').value;

    const { valid } = await checkInviteCode(code);
    if (!valid) {
      msg.innerHTML = '<p class="error">邀请码无效或已被使用</p>';
      btn.disabled = false;
      btn.querySelector('.btn-text').textContent = '注册';
      return;
    }

    const { data: authData, error: authError } = await signUp(email, password);
    if (authError) {
      msg.innerHTML = `<p class="error">${authError.message}</p>`;
      btn.disabled = false;
      btn.querySelector('.btn-text').textContent = '注册';
      return;
    }

    await consumeInviteCode(code, email);
    if (authData.session) localStorage.setItem('sb_token', authData.session.access_token);
    msg.innerHTML = '<p class="success">注册成功，正在跳转登录页...</p>';
    setTimeout(() => window.location.href = '/login', 1500);
  });
</script>

<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
    padding: 2rem 1rem;
  }

  .auth-glow {
    position: absolute;
    top: 25%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 600px;
    height: 600px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.08) 0%, rgba(6, 182, 212, 0.03) 40%, transparent 65%);
    pointer-events: none;
    animation: pulse-glow 5s ease-in-out infinite;
  }

  .auth-glow-secondary {
    position: absolute;
    bottom: 10%;
    right: 15%;
    width: 300px;
    height: 300px;
    background: radial-gradient(circle, rgba(6, 182, 212, 0.04) 0%, transparent 70%);
    pointer-events: none;
    animation: float 7s ease-in-out infinite;
  }

  .auth-box {
    width: 100%;
    max-width: 420px;
    padding: 2rem;
    position: relative;
    z-index: 1;
  }

  .back-link {
    display: inline-flex;
    align-items: center;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.8125rem;
    margin-bottom: 2.5rem;
    transition: all 0.3s ease;
  }

  .back-link:hover {
    color: var(--accent-light);
    text-shadow: 0 0 8px var(--accent-glow);
  }

  .auth-header {
    text-align: center;
    margin-bottom: 2.5rem;
  }

  .auth-logo {
    width: 56px;
    height: 56px;
    margin: 0 auto 1.25rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dim) 100%);
    color: #fff;
    border-radius: 16px;
    box-shadow: 0 4px 20px var(--accent-glow);
  }

  .auth-header h1 {
    font-size: 1.625rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
    letter-spacing: -0.02em;
  }

  .subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
    letter-spacing: 0.02em;
  }

  .form-group {
    margin-bottom: 1rem;
  }

  .form-group label {
    display: block;
    font-size: 0.8125rem;
    font-weight: 500;
    color: var(--text-muted);
    margin-bottom: 0.5rem;
    letter-spacing: 0.02em;
  }

  .input-hint {
    display: block;
    font-size: 0.75rem;
    color: var(--text-faint);
    margin-top: 0.5rem;
    letter-spacing: 0.02em;
  }

  .submit-btn {
    width: 100%;
    margin-top: 0.75rem;
    padding: 1rem;
    font-size: 0.9375rem;
  }

  .auth-links {
    margin-top: 2rem;
    text-align: center;
    font-size: 0.8125rem;
  }

  .auth-link {
    color: var(--text-dim);
    text-decoration: none;
    transition: all 0.3s ease;
    padding: 0.5rem;
  }

  .auth-link:hover {
    color: var(--accent-light);
    text-shadow: 0 0 8px var(--accent-glow);
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(8px, -12px); }
  }
</style>
