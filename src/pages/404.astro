---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面不存在 - 冰箱里的世界">
  <div class="error-page">
    <div class="error-glow"></div>
    <div class="error-glow-secondary"></div>
    <div class="error-container animate-fade-in-up">
      <div class="error-code">
        <span>4</span>
        <div class="error-icon">
          <svg width="40" height="40" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="10"/>
            <line x1="12" y1="8" x2="12" y2="12"/>
            <line x1="12" y1="16" x2="12.01" y2="16"/>
          </svg>
        </div>
        <span>4</span>
      </div>
      <p class="error-desc">这个页面不存在，或者你没有权限访问。</p>
      <a href="/" class="btn btn-primary error-btn">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.5rem;">
          <path d="M3 9l9-7 9 7v11a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2z"/>
          <polyline points="9 22 9 12 15 12 15 22"/>
        </svg>
        返回首页
      </a>
    </div>
  </div>
</Layout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .error-glow {
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.07) 0%, rgba(6, 182, 212, 0.03) 40%, transparent 65%);
    pointer-events: none;
    animation: pulse-glow 4s ease-in-out infinite;
  }

  .error-glow-secondary {
    position: absolute;
    top: 25%;
    left: 35%;
    width: 150px;
    height: 150px;
    background: radial-gradient(circle, rgba(239, 68, 68, 0.05) 0%, transparent 70%);
    pointer-events: none;
    animation: float 6s ease-in-out infinite;
  }

  .error-container {
    text-align: center;
    padding: 2rem;
    position: relative;
    z-index: 1;
  }

  .error-code {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 1rem;
    margin-bottom: 1.5rem;
  }

  .error-code span {
    font-size: 6rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-light) 50%, var(--cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: -0.05em;
    line-height: 1;
  }

  .error-icon {
    width: 64px;
    height: 64px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: var(--error-bg);
    border: 1.5px solid rgba(239, 68, 68, 0.2);
    border-radius: 20px;
    color: var(--error);
    animation: pulse 3s ease-in-out infinite;
  }

  .error-desc {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
    letter-spacing: 0.02em;
  }

  .error-btn {
    display: inline-flex;
    align-items: center;
    padding: 1rem 2rem;
  }

  @keyframes pulse-glow {
    0%, 100% { opacity: 0.6; transform: translate(-50%, -50%) scale(1); }
    50% { opacity: 1; transform: translate(-50%, -50%) scale(1.1); }
  }

  @keyframes float {
    0%, 100% { transform: translate(0, 0); }
    50% { transform: translate(8px, -12px); }
  }

  @keyframes pulse {
    0%, 100% { opacity: 1; transform: scale(1); }
    50% { opacity: 0.8; transform: scale(1.05); }
  }

  @media (max-width: 640px) {
    .error-code span {
      font-size: 4rem;
    }
    .error-icon {
      width: 48px;
      height: 48px;
      border-radius: 14px;
    }
  }
</style>
