---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面不存在 - 冰箱里的世界">
  <div class="error-page">
    <div class="error-glow"></div>
    <div class="error-container">
      <h1>404</h1>
      <p>这个页面不存在，或者你没有权限访问。</p>
      <a href="/" class="btn btn-primary">返回首页</a>
    </div>
  </div>
</Layout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .error-glow {
    position: absolute;
    top: 40%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 400px;
    height: 400px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.08) 0%, rgba(6, 182, 212, 0.03) 40%, transparent 65%);
    pointer-events: none;
  }
  .error-container {
    text-align: center;
    padding: 2rem;
    position: relative;
    z-index: 1;
  }
  .error-container h1 {
    font-size: 6rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-light) 50%, var(--cyan) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 1rem;
    letter-spacing: -0.05em;
  }
  .error-container p {
    font-size: 1rem;
    color: var(--text-muted);
    margin-bottom: 2rem;
  }
</style>
