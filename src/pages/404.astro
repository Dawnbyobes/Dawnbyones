---
import Layout from '../layouts/Layout.astro';
---

<Layout title="404">
  <div class="error-page">
    <div class="error-box">
      <h1>404</h1>
      <p>页面不存在</p>
      <a href="/" class="btn btn-secondary">返回首页</a>
    </div>
  </div>
</Layout>

<style>
  .error-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .error-box {
    text-align: center;
  }
  .error-box h1 {
    font-size: 48px;
    font-weight: 600;
    letter-spacing: -0.02em;
    margin-bottom: 8px;
    color: var(--text-tertiary);
  }
  .error-box p {
    font-size: 15px;
    color: var(--text-secondary);
    margin-bottom: 24px;
  }
</style>
