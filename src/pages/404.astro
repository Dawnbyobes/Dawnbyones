---
import Layout from '../layouts/Layout.astro';
---

<Layout title="页面不存在 - 冰箱里的世界">
  <div class="error-container">
    <h1>404</h1>
    <p>这个页面不存在，或者你没有权限访问。</p>
    <a href="/" class="btn btn-primary">返回首页</a>
  </div>
</Layout>

<style>
  .error-container {
    min-height: 100vh;
    display: flex;
    flex-direction: column;
    align-items: center;
    justify-content: center;
    text-align: center;
    padding: 2rem;
  }
  
  .error-container h1 {
    font-size: 6rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 1rem;
    letter-spacing: -0.05em;
  }
  
  .error-container p {
    font-size: 1rem;
    color: var(--text-dim);
    margin-bottom: 2rem;
  }
</style>
