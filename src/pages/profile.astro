---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="设置 - 冰箱里的世界">
  <Header />

  <main class="container">
    <div class="profile-header">
      <h1>设置</h1>
      <p id="readerId">加载中...</p>
    </div>

    <div class="card">
      <h2 class="card-title">昵称</h2>
      <form id="profileForm">
        <input type="text" id="displayName" placeholder="输入显示名称" autocomplete="off" />
        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-small" id="saveProfileBtn">保存</button>
        </div>
      </form>
      <div class="message" id="profileMessage"></div>
    </div>

    <div class="card">
      <h2 class="card-title">书签</h2>
      <div id="bookmarksList">
        <div class="loading">加载中...</div>
      </div>
    </div>

    <div class="card">
      <h2 class="card-title">账户</h2>
      <div class="account-actions">
        <a href="/login" class="btn btn-secondary btn-small">切换账号</a>
        <button class="btn btn-danger btn-small" id="logoutBtn">退出登录</button>
      </div>
    </div>
  </main>

  <footer class="container site-footer">
    <p>2026 冰箱里的世界 · 仅供会员阅读</p>
  </footer>
</Layout>

<script type="module">
  import { getSession, getProfile, updateProfile, getBookmarks, removeBookmark, signOut } from '/lib/supabase.js';
  import { formatDate, showToast } from '/lib/utils.js';

  const session = await getSession();
  if (!session) window.location.href = '/login';

  async function loadProfile() {
    const profile = await getProfile();
    if (profile) {
      document.getElementById('readerId').textContent = profile.reader_id;
      document.getElementById('displayName').value = profile.display_name || '';
    }
  }

  async function loadBookmarks() {
    const { data: bookmarks, error } = await getBookmarks();
    const list = document.getElementById('bookmarksList');
    if (error || !bookmarks || bookmarks.length === 0) {
      list.innerHTML = '<div class="empty">暂无书签</div>';
      return;
    }
    list.innerHTML = bookmarks.map(b => `
      <div class="bookmark-item">
        <a href="/read?id=${b.chapter_id}" class="bookmark-link">第${b.chapters?.order_num || '?'}章 · ${b.chapters?.title || '未知章节'}</a>
        <button class="remove-btn" data-id="${b.id}">移除</button>
      </div>
    `).join('');
    list.querySelectorAll('.remove-btn').forEach(btn => {
      btn.addEventListener('click', async () => {
        const { error } = await removeBookmark(btn.dataset.id);
        if (!error) { showToast('已移除'); loadBookmarks(); }
      });
    });
  }

  document.getElementById('profileForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('saveProfileBtn');
    btn.disabled = true;
    btn.textContent = '保存中...';
    const displayName = document.getElementById('displayName').value.trim();
    const { error } = await updateProfile({ display_name: displayName });
    const msg = document.getElementById('profileMessage');
    if (error) msg.innerHTML = `<p class="error">${error.message}</p>`;
    else { msg.innerHTML = '<p class="success">已更新</p>'; loadProfile(); showToast('已更新'); }
    btn.disabled = false;
    btn.textContent = '保存';
  });

  document.getElementById('logoutBtn')?.addEventListener('click', async () => {
    await signOut();
    window.location.href = '/';
  });

  loadProfile();
  loadBookmarks();
</script>

<style>
  .profile-header {
    padding: 32px 0 24px;
  }
  .profile-header h1 {
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 6px;
    letter-spacing: -0.01em;
  }
  .profile-header p {
    font-size: 13px;
    color: var(--text-tertiary);
    font-family: monospace;
  }

  .card { margin-bottom: 16px; }
  .card-title {
    font-size: 13px;
    font-weight: 500;
    color: var(--text-secondary);
    margin-bottom: 16px;
    letter-spacing: 0.02em;
  }

  .form-actions {
    display: flex;
    justify-content: flex-end;
    margin-top: 12px;
  }

  .loading {
    padding: 24px 0;
    text-align: center;
    color: var(--text-tertiary);
    font-size: 13px;
  }
  .bookmark-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 12px 0;
    border-bottom: 1px solid var(--border);
  }
  .bookmark-item:last-child { border-bottom: none; }
  .bookmark-link {
    color: var(--text);
    text-decoration: none;
    font-size: 14px;
    transition: opacity 0.2s;
  }
  .bookmark-link:hover { opacity: 0.6; }
  .remove-btn {
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 12px;
    cursor: pointer;
    padding: 4px 8px;
    transition: color 0.2s;
    font-family: inherit;
  }
  .remove-btn:hover { color: #ef4444; }

  .account-actions {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }
</style>
