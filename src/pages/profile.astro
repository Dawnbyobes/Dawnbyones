---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="个人中心 - 冰箱里的世界">
  <Header />

  <main class="container">
    <!-- 个人资料头部 -->
    <div class="profile-header animate-fade-in-up">
      <div class="profile-avatar">
        <svg width="28" height="28" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="1.5" stroke-linecap="round" stroke-linejoin="round">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
          <circle cx="12" cy="7" r="4"/>
        </svg>
      </div>
      <h1>个人中心</h1>
      <p id="readerId">加载中...</p>
    </div>

    <!-- 基本资料卡片 -->
    <div class="card profile-card animate-fade-in-up stagger-1">
      <div class="card-header">
        <div class="card-icon">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M11 4H4a2 2 0 0 0-2 2v14a2 2 0 0 0 2 2h14a2 2 0 0 0 2-2v-7"/>
            <path d="M18.5 2.5a2.121 2.121 0 0 1 3 3L12 15l-4 1 1-4 9.5-9.5z"/>
          </svg>
        </div>
        <h2>基本资料</h2>
      </div>
      <form id="profileForm">
        <div class="form-group">
          <label for="displayName">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
              <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
              <circle cx="12" cy="7" r="4"/>
            </svg>
            显示名称
          </label>
          <input type="text" id="displayName" placeholder="你的昵称" autocomplete="off" />
          <span class="input-hint">其他读者将看到此名称</span>
        </div>
        <div class="form-actions">
          <button type="submit" class="btn btn-primary btn-small" id="saveProfileBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.375rem;">
              <path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/>
              <polyline points="17 21 17 13 7 13 7 21"/>
              <polyline points="7 3 7 8 15 8"/>
            </svg>
            保存修改
          </button>
        </div>
      </form>
      <div class="message" id="profileMessage"></div>
    </div>

    <!-- 书签卡片 -->
    <div class="card bookmarks-card animate-fade-in-up stagger-2">
      <div class="card-header">
        <div class="card-icon icon-cyan">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M19 21l-7-5-7 5V5a2 2 0 0 1 2-2h10a2 2 0 0 1 2 2z"/>
          </svg>
        </div>
        <h2>我的书签</h2>
      </div>
      <div id="bookmarksList">
        <div class="loading-state">
          <div class="loading-spinner"></div>
          <span>加载中...</span>
        </div>
      </div>
    </div>

    <!-- 账户卡片 -->
    <div class="card account-card animate-fade-in-up stagger-3">
      <div class="card-header">
        <div class="card-icon icon-accent">
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="12" cy="12" r="3"/>
            <path d="M19.4 15a1.65 1.65 0 0 0 .33 1.82l.06.06a2 2 0 0 1 0 2.83 2 2 0 0 1-2.83 0l-.06-.06a1.65 1.65 0 0 0-1.82-.33 1.65 1.65 0 0 0-1 1.51V21a2 2 0 0 1-2 2 2 2 0 0 1-2-2v-.09A1.65 1.65 0 0 0 9 19.4a1.65 1.65 0 0 0-1.82.33l-.06.06a2 2 0 0 1-2.83 0 2 2 0 0 1 0-2.83l.06-.06a1.65 1.65 0 0 0 .33-1.82 1.65 1.65 0 0 0-1.51-1H3a2 2 0 0 1-2-2 2 2 0 0 1 2-2h.09A1.65 1.65 0 0 0 4.6 9a1.65 1.65 0 0 0-.33-1.82l-.06-.06a2 2 0 0 1 0-2.83 2 2 0 0 1 2.83 0l.06.06a1.65 1.65 0 0 0 1.82.33H9a1.65 1.65 0 0 0 1-1.51V3a2 2 0 0 1 2-2 2 2 0 0 1 2 2v.09a1.65 1.65 0 0 0 1 1.51 1.65 1.65 0 0 0 1.82-.33l.06-.06a2 2 0 0 1 2.83 0 2 2 0 0 1 0 2.83l-.06.06a1.65 1.65 0 0 0-.33 1.82V9a1.65 1.65 0 0 0 1.51 1H21a2 2 0 0 1 2 2 2 2 0 0 1-2 2h-.09a1.65 1.65 0 0 0-1.51 1z"/>
          </svg>
        </div>
        <h2>账户</h2>
      </div>
      <div class="account-actions">
        <a href="/login" class="btn btn-secondary btn-small switch-account-btn" style="text-decoration:none;">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.375rem;">
            <polyline points="15 3 21 3 21 9"/>
            <path d="M18 13v6a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2V8a2 2 0 0 1 2-2h6"/>
          </svg>
          切换账号
        </a>
        <button class="btn btn-danger btn-small" id="logoutBtn">
          <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.375rem;">
            <path d="M9 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h4"/>
            <polyline points="16 17 21 12 16 7"/>
            <line x1="21" y1="12" x2="9" y2="12"/>
          </svg>
          退出登录
        </button>
      </div>
    </div>
  </main>

  <footer class="container">
    <div class="footer-line"></div>
    <p>2026 冰箱里的世界 · 仅供会员阅读</p>
  </footer>
</Layout>

<script type="module">
  import {
    getSession, getProfile, updateProfile,
    getBookmarks, removeBookmark, signOut
  } from '/lib/supabase.js';
  import { formatDate, showToast } from '/lib/utils.js';

  const session = await getSession();
  if (!session) window.location.href = '/login';

  async function loadProfile() {
    const profile = await getProfile();
    if (profile) {
      document.getElementById('readerId').textContent = `ID: ${profile.reader_id}`;
      document.getElementById('displayName').value = profile.display_name || '';
    }
  }

  async function loadBookmarks() {
    const { data: bookmarks, error } = await getBookmarks();
    const list = document.getElementById('bookmarksList');
    if (error || !bookmarks || bookmarks.length === 0) {
      list.innerHTML = '<div class="empty">暂无书签</div>';
      return;
    }
    list.innerHTML = bookmarks.map(b => `
      <div class="bookmark-item">
        <div class="bookmark-info" onclick="location.href='/read?id=${b.chapter_id}'">
          <div class="bookmark-chapter">第${b.chapters?.order_num || '?'}章 · ${b.chapters?.title || '未知章节'}</div>
          <span class="bookmark-date">${formatDate(b.created_at)}</span>
        </div>
        <button class="remove-bookmark" data-id="${b.id}" title="移除书签">
          <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="18" y1="6" x2="6" y2="18"/>
            <line x1="6" y1="6" x2="18" y2="18"/>
          </svg>
        </button>
      </div>
    `).join('');
    list.querySelectorAll('.remove-bookmark').forEach(btn => {
      btn.addEventListener('click', async () => {
        const { error } = await removeBookmark(btn.dataset.id);
        if (!error) { showToast('书签已移除'); loadBookmarks(); }
      });
    });
  }

  document.getElementById('profileForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('saveProfileBtn');
    btn.disabled = true;
    btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.375rem; animation: spin 0.6s linear infinite;"><polyline points="23 4 23 10 17 10"/></svg>保存中...`;
    const displayName = document.getElementById('displayName').value.trim();
    const { error } = await updateProfile({ display_name: displayName });
    const msg = document.getElementById('profileMessage');
    if (error) msg.innerHTML = `<p class="error">保存失败：${error.message}</p>`;
    else { msg.innerHTML = '<p class="success">资料已更新</p>'; loadProfile(); showToast('资料已更新'); }
    btn.disabled = false;
    btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.375rem;"><path d="M19 21H5a2 2 0 0 1-2-2V5a2 2 0 0 1 2-2h11l5 5v11a2 2 0 0 1-2 2z"/><polyline points="17 21 17 13 7 13 7 21"/><polyline points="7 3 7 8 15 8"/></svg>保存修改`;
  });

  document.getElementById('logoutBtn')?.addEventListener('click', async () => {
    await signOut();
    window.location.href = '/';
  });

  loadProfile();
  loadBookmarks();
</script>

<style>
  .profile-header {
    padding: 2.5rem 0 2rem;
    text-align: center;
  }

  .profile-avatar {
    width: 64px;
    height: 64px;
    margin: 0 auto 1rem;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent-dim) 0%, var(--accent) 100%);
    color: #fff;
    border-radius: 18px;
    box-shadow: 0 4px 20px var(--accent-glow);
    transition: transform 0.3s ease;
  }

  .profile-header:hover .profile-avatar {
    transform: scale(1.05) rotate(-5deg);
  }

  .profile-header h1 {
    font-size: 1.625rem;
    font-weight: 700;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    margin-bottom: 0.5rem;
  }

  .profile-header p {
    font-size: 0.875rem;
    color: var(--text-muted);
    font-family: monospace;
    letter-spacing: 0.05em;
  }

  /* 卡片 */
  .profile-card { margin-bottom: 1.5rem; }
  .bookmarks-card { margin-bottom: 1.5rem; }
  .account-card { margin-bottom: 2rem; }

  .card-header {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-bottom: 1.5rem;
  }

  .card-icon {
    width: 36px;
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: linear-gradient(135deg, var(--accent-dim) 0%, var(--accent) 100%);
    color: #fff;
    border-radius: 10px;
    box-shadow: 0 4px 12px var(--accent-glow);
  }

  .card-icon.icon-cyan {
    background: linear-gradient(135deg, #0891b2 0%, #06b6d4 100%);
    box-shadow: 0 4px 12px rgba(6, 182, 212, 0.25);
  }

  .card-icon.icon-accent {
    background: linear-gradient(135deg, #7c3aed 0%, #a78bfa 100%);
    box-shadow: 0 4px 12px rgba(124, 58, 237, 0.25);
  }

  .card h2 {
    font-size: 1.0625rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  /* 表单 */
  .form-group { margin-bottom: 1.25rem; }

  .form-group label {
    display: flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
    margin-bottom: 0.625rem;
    font-weight: 500;
  }

  .input-hint {
    display: block;
    font-size: 0.75rem;
    color: var(--text-faint);
    margin-top: 0.5rem;
    letter-spacing: 0.02em;
  }

  .form-actions { display: flex; justify-content: flex-end; }

  /* 书签 */
  .bookmark-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 0.875rem 0;
    border-bottom: 1px solid var(--border-color);
    gap: 1rem;
    transition: all 0.25s ease;
  }

  .bookmark-item:last-child { border-bottom: none; }

  .bookmark-item:hover { padding-left: 0.5rem; }

  .bookmark-info {
    flex: 1;
    cursor: pointer;
    transition: opacity 0.25s;
    min-width: 0;
  }

  .bookmark-info:hover { opacity: 0.8; }

  .bookmark-chapter {
    font-size: 0.9375rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .bookmark-date { font-size: 0.75rem; color: var(--text-faint); letter-spacing: 0.02em; }

  .remove-bookmark {
    width: 32px;
    height: 32px;
    display: flex;
    align-items: center;
    justify-content: center;
    background: none;
    border: 1px solid transparent;
    color: var(--text-dim);
    border-radius: 8px;
    cursor: pointer;
    transition: all 0.25s ease;
    flex-shrink: 0;
  }

  .remove-bookmark:hover {
    color: var(--error);
    background: var(--error-bg);
    border-color: rgba(239, 68, 68, 0.15);
  }

  /* 加载状态 */
  .loading-state {
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 0.75rem;
    padding: 2rem;
    color: var(--text-faint);
    font-size: 0.875rem;
  }

  .loading-spinner {
    width: 18px;
    height: 18px;
    border: 2px solid var(--text-faint);
    border-top-color: var(--accent-light);
    border-radius: 50%;
    animation: spin 0.6s linear infinite;
  }

  @keyframes spin { to { transform: rotate(360deg); } }

  /* 账户 */
  .account-actions {
    display: flex;
    gap: 0.75rem;
    flex-wrap: wrap;
  }

  .switch-account-btn {
    display: inline-flex;
    align-items: center;
  }

  /* Footer */
  footer {
    padding: 2rem 0;
    text-align: center;
  }

  .footer-line {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-color), transparent);
    margin-bottom: 2rem;
  }

  footer p {
    font-size: 0.75rem;
    color: var(--text-faint);
    letter-spacing: 0.08em;
  }
</style>
