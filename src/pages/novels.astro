<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>小说目录 - 冰箱里的世界</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
        background: #faf9f7;
        color: #333;
        line-height: 1.6;
      }
      .container { max-width: 800px; margin: 0 auto; padding: 0 1.5rem; }
      
      header {
        padding: 1.5rem 0;
        border-bottom: 1px solid #e5e5e5;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      .logo { font-size: 1.25rem; font-weight: 600; color: #222; text-decoration: none; }
      .logout {
        background: none;
        border: 1px solid #ddd;
        padding: 0.5rem 1rem;
        border-radius: 6px;
        cursor: pointer;
        font-size: 0.875rem;
      }
      .logout:hover { background: #f5f5f5; }
      
      .hero {
        text-align: center;
        padding: 3rem 0 2rem;
      }
      .hero h1 { font-size: 2rem; margin-bottom: 0.5rem; }
      .hero p { color: #666; }
      
      .novel-list {
        display: grid;
        gap: 1.5rem;
        margin: 2rem 0 4rem;
      }
      
      .novel-card {
        background: #fff;
        border: 1px solid #e5e5e5;
        border-radius: 12px;
        padding: 1.5rem;
      }
      .novel-card h3 { font-size: 1.25rem; margin-bottom: 0.5rem; }
      .novel-card p { color: #666; font-size: 0.875rem; margin-bottom: 1rem; }
      .novel-card .meta { color: #999; font-size: 0.75rem; }
      
      .read-btn {
        display: inline-block;
        background: #1a1a1a;
        color: #fff;
        padding: 0.5rem 1.5rem;
        border-radius: 6px;
        text-decoration: none;
        font-size: 0.875rem;
        margin-top: 1rem;
      }
      
      footer {
        text-align: center;
        padding: 2rem 0;
        border-top: 1px solid #e5e5e5;
        color: #999;
        font-size: 0.875rem;
      }
    </style>
  </head>
  <body>
    <header class="container">
      <a href="/" class="logo">📚 冰箱里的世界</a>
      <button class="logout" onclick="logout()">退出登录</button>
    </header>
    
    <main class="container">
      <div class="hero">
        <h1>📖 小说目录</h1>
        <p>会员专属阅读区</p>
      </div>
      
      <div class="novel-list">
        <div class="novel-card">
          <h3>冰箱里的世界</h3>
          <p>一个关于冰箱内部微观世界的故事...</p>
          <div class="meta">连载中 · 3 章</div>
          <a href="#" class="read-btn">开始阅读</a>
        </div>
        
        <div class="novel-card">
          <h3>待添加作品</h3>
          <p>更多小说即将上线...</p>
          <div class="meta">敬请期待</div>
        </div>
      </div>
    </main>
    
    <footer>
      <div class="container">
        <p>© 2026 冰箱里的世界 · 仅供会员阅读</p>
      </div>
    </footer>
    
    <script>
      // 检查登录状态
      const token = localStorage.getItem('sb_token');
      if (!token) {
        window.location.href = '/login';
      }
      
      function logout() {
        localStorage.removeItem('sb_token');
        window.location.href = '/';
      }
    </script>
  </body>
</html>