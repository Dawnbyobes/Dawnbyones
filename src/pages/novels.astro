<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>目录 - 冰箱里的世界</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", "Noto Sans SC", sans-serif;
        background: #0a0a0a;
        color: #e5e5e5;
        line-height: 1.8;
        min-height: 100vh;
      }
      
      .container {
        max-width: 720px;
        margin: 0 auto;
        padding: 0 2rem;
      }
      
      header {
        padding: 2rem 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        border-bottom: 1px solid #111;
      }
      
      .logo {
        font-size: 1rem;
        font-weight: 500;
        color: #fff;
        text-decoration: none;
        letter-spacing: 0.05em;
      }
      
      .nav a {
        color: #555;
        text-decoration: none;
        margin-left: 2rem;
        font-size: 0.875rem;
        transition: color 0.2s;
        cursor: pointer;
      }
      
      .nav a:hover {
        color: #fff;
      }
      
      .hero {
        padding: 4rem 0 3rem;
      }
      
      .hero h1 {
        font-size: 1.75rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 0.5rem;
      }
      
      .hero p {
        font-size: 0.875rem;
        color: #555;
      }
      
      .chapter-list {
        padding-bottom: 6rem;
      }
      
      .chapter-item {
        padding: 1.5rem 0;
        border-bottom: 1px solid #111;
        cursor: pointer;
        transition: opacity 0.2s;
      }
      
      .chapter-item:hover {
        opacity: 0.7;
      }
      
      .chapter-item h3 {
        font-size: 1rem;
        font-weight: 500;
        color: #fff;
        margin-bottom: 0.25rem;
      }
      
      .chapter-item .meta {
        font-size: 0.75rem;
        color: #444;
      }
      
      .empty {
        padding: 6rem 0;
        text-align: center;
        color: #444;
        font-size: 0.875rem;
      }
      
      footer {
        padding: 3rem 0;
        text-align: center;
        font-size: 0.75rem;
        color: #222;
        border-top: 1px solid #111;
      }
    </style>
  </head>
  <body>
    <header class="container">
      <a href="/" class="logo">冰箱里的世界</a>
      <nav class="nav">
        <a href="/">首页</a>
        <a onclick="logout()">退出</a>
      </nav>
    </header>
    
    <main class="container">
      <div class="hero">
        <h1>目录</h1>
        <p>会员专属阅读区</p>
      </div>
      
      <div class="chapter-list" id="chapterList">
        <div class="empty">加载中...</div>
      </div>
    </main>
    
    <footer class="container">
      <p>© 2026 冰箱里的世界 · 仅供会员阅读</p>
    </footer>
    
    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.39.0';
      
      const SUPABASE_URL = 'https://cwkqlwdeteitisdrlwmg.supabase.co';
      const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN3a3Fsd2RldGVpdGlzZHJsd21nIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEyODkwMzMsImV4cCI6MjA5Njg2NTAzM30.hSbK_Z1rH9pXUwpfh2o5ZxbpkRUyy_7xDYcrmvLXgq8';
      const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);
      
      const token = localStorage.getItem('sb_token');
      if (!token) {
        window.location.href = '/login';
      }
      
      async function loadChapters() {
        const { data: chapters, error } = await supabase
          .from('chapters')
          .select('*')
          .order('order_num', { ascending: true });
        
        const list = document.getElementById('chapterList');
        
        if (error) {
          list.innerHTML = '<div class="empty">加载失败</div>';
          return;
        }
        
        if (!chapters || chapters.length === 0) {
          list.innerHTML = '<div class="empty">暂无章节，请等待作者更新</div>';
          return;
        }
        
        list.innerHTML = chapters.map(c => `
          <div class="chapter-item" onclick="location.href='/read?id=${c.id}'">
            <h3>第${c.order_num}章 · ${c.title}</h3>
            <div class="meta">${new Date(c.created_at).toLocaleDateString('zh-CN')}</div>
          </div>
        `).join('');
      }
      
      window.logout = function() {
        localStorage.removeItem('sb_token');
        window.location.href = '/';
      };
      
      loadChapters();
    </script>
  </body>
</html>