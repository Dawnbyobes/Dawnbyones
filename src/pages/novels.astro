<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>目录 - 冰箱里的世界</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: "SF Mono", "Fira Code", "JetBrains Mono", "Courier New", monospace;
        background: #0a0a0a;
        color: #e0e0e0;
        min-height: 100vh;
      }
      
      .container {
        max-width: 720px;
        margin: 0 auto;
        padding: 0 2rem;
      }
      
      header {
        padding: 2rem 0;
        border-bottom: 1px solid #1a1a1a;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      
      .logo {
        font-size: 0.875rem;
        color: #fff;
        text-decoration: none;
      }
      
      .logo::before {
        content: ">";
        margin-right: 0.5rem;
      }
      
      .nav a {
        color: #555;
        text-decoration: none;
        margin-left: 2rem;
        font-size: 0.8125rem;
        transition: color 0.2s;
        cursor: pointer;
      }
      
      .nav a:hover {
        color: #fff;
      }
      
      main {
        padding: 4rem 0;
      }
      
      .page-title {
        font-size: 1.25rem;
        font-weight: 400;
        color: #fff;
        margin-bottom: 3rem;
      }
      
      .page-title::before {
        content: ">";
        margin-right: 0.5rem;
      }
      
      .chapter-list {
        display: flex;
        flex-direction: column;
        gap: 1px;
        background: #1a1a1a;
      }
      
      .chapter-item {
        background: #0a0a0a;
        padding: 1.25rem 1.5rem;
        cursor: pointer;
        transition: background 0.2s;
        display: flex;
        justify-content: space-between;
        align-items: center;
      }
      
      .chapter-item:hover {
        background: #111;
      }
      
      .chapter-item h3 {
        font-size: 0.9375rem;
        font-weight: 400;
        color: #e0e0e0;
      }
      
      .chapter-item .meta {
        font-size: 0.75rem;
        color: #333;
      }
      
      .empty {
        padding: 4rem 0;
        text-align: center;
        color: #333;
        font-size: 0.875rem;
      }
      
      footer {
        padding: 2rem 0;
        border-top: 1px solid #1a1a1a;
      }
      
      footer p {
        font-size: 0.75rem;
        color: #222;
      }
    </style>
  </head>
  <body>
    <header class="container">
      <a href="/" class="logo">冰箱里的世界</a>
      <nav class="nav">
        <a href="/">首页</a>
        <a onclick="logout()">退出</a>
      </nav>
    </header>
    
    <main class="container">
      <h1 class="page-title">章节目录</h1>
      <div class="chapter-list" id="chapterList">
        <div class="empty">加载中...</div>
      </div>
    </main>
    
    <footer class="container">
      <p>© 2026 冰箱里的世界</p>
    </footer>
    
    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.39.0';
      
      const SUPABASE_URL = 'https://cwkqlwdeteitisdrlwmg.supabase.co';
      const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN3a3Fsd2RldGVpdGlzZHJsd21nIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEyODkwMzMsImV4cCI6MjA5Njg2NTAzM30.hSbK_Z1rH9pXUwpfh2o5ZxbpkRUyy_7xDYcrmvLXgq8';
      const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);
      
      const token = localStorage.getItem('sb_token');
      if (!token) {
        window.location.href = '/login';
      }
      
      async function loadChapters() {
        const { data: chapters, error } = await supabase
          .from('chapters')
          .select('*')
          .order('order_num', { ascending: true });
        
        const list = document.getElementById('chapterList');
        
        if (error) {
          list.innerHTML = '<div class="empty">加载失败</div>';
          return;
        }
        
        if (!chapters || chapters.length === 0) {
          list.innerHTML = '<div class="empty">暂无章节</div>';
          return;
        }
        
        list.innerHTML = chapters.map(c => `
          <div class="chapter-item" onclick="location.href='/read?id=${c.id}'">
            <h3>第${c.order_num}章 ${c.title}</h3>
            <span class="meta">${new Date(c.created_at).toLocaleDateString('zh-CN')}</span>
          </div>
        `).join('');
      }
      
      window.logout = function() {
        localStorage.removeItem('sb_token');
        window.location.href = '/';
      };
      
      loadChapters();
    </script>
  </body>
</html>