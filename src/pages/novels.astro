---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="目录 - 冰箱里的世界">
  <Header />

  <main class="container">
    <div class="notice" id="notice">
      <span class="notice-label">公告</span>
      <span id="noticeContent">加载中...</span>
    </div>

    <div class="page-header">
      <h1>目录</h1>
      <div class="last-read" id="lastRead"></div>
    </div>

    <div class="search-bar">
      <input type="text" id="searchInput" placeholder="搜索章节..." autocomplete="off" />
      <span class="search-count" id="searchCount"></span>
    </div>

    <div class="chapter-list" id="chapterList">
      <div class="loading">加载中...</div>
    </div>
  </main>

  <footer class="container site-footer">
    <p>2026 冰箱里的世界 · 仅供会员阅读</p>
  </footer>
</Layout>

<script type="module">
  import { getChapters, getAnnouncement, getBookmarks, getSession } from '/lib/supabase.js';
  import { debounce, highlightText } from '/lib/utils.js';

  const session = await getSession();
  if (!session) window.location.href = '/login';

  let allChapters = [];
  let bookmarksMap = new Set();

  async function loadData() {
    const noticeText = await getAnnouncement();
    document.getElementById('noticeContent').textContent = noticeText;
    const { data: chapters, error } = await getChapters();
    allChapters = chapters || [];
    if (error) { document.getElementById('chapterList').innerHTML = '<div class="empty">加载失败</div>'; return; }
    const { data: bookmarks } = await getBookmarks();
    bookmarksMap = new Set((bookmarks || []).map(b => b.chapter_id));
    const lastChapterId = localStorage.getItem('last_read_chapter');
    if (lastChapterId) {
      const lastChapter = allChapters.find(c => c.id === lastChapterId);
      if (lastChapter) {
        document.getElementById('lastRead').innerHTML =
          `<a href="/read?id=${lastChapterId}" class="continue-link">继续阅读：第${lastChapter.order_num}章 ${lastChapter.title}</a>`;
      }
    }
    renderChapters(allChapters);
  }

  function renderChapters(chapters, keyword = '') {
    const list = document.getElementById('chapterList');
    const countEl = document.getElementById('searchCount');
    if (!chapters || chapters.length === 0) { list.innerHTML = '<div class="empty">暂无章节</div>'; countEl.textContent = ''; return; }
    countEl.textContent = keyword ? `${chapters.length} 个结果` : `共 ${chapters.length} 章`;
    list.innerHTML = chapters.map(c => {
      const isBookmarked = bookmarksMap.has(c.id);
      const titleHtml = keyword ? highlightText(c.title, keyword) : c.title;
      return `
        <div class="chapter-item" onclick="location.href='/read?id=${c.id}'">
          <div class="chapter-info">
            <span class="chapter-num">${c.order_num}</span>
            <span class="chapter-title">${titleHtml}</span>
          </div>
          <div class="chapter-meta">
            ${isBookmarked ? '<span class="bookmarked">已收藏</span>' : ''}
            <span class="chapter-date">${new Date(c.created_at).toLocaleDateString('zh-CN')}</span>
          </div>
        </div>
      `;
    }).join('');
  }

  const searchInput = document.getElementById('searchInput');
  searchInput?.addEventListener('input', debounce((e) => {
    const keyword = e.target.value.trim().toLowerCase();
    if (!keyword) { renderChapters(allChapters); return; }
    const filtered = allChapters.filter(c => c.title.toLowerCase().includes(keyword) || c.order_num.toString().includes(keyword));
    renderChapters(filtered, keyword);
  }, 200));

  loadData();
</script>

<style>
  .notice {
    margin: 24px 0;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    font-size: 14px;
  }
  .notice-label {
    font-size: 11px;
    font-weight: 500;
    color: var(--accent);
    letter-spacing: 0.1em;
    margin-right: 12px;
  }
  #noticeContent { color: var(--text-secondary); }

  .page-header {
    padding: 16px 0 12px;
  }
  .page-header h1 {
    font-size: 22px;
    font-weight: 600;
    letter-spacing: -0.01em;
  }
  .last-read { margin-top: 12px; }
  .continue-link {
    font-size: 13px;
    color: var(--accent);
    text-decoration: none;
  }
  .continue-link:hover { text-decoration: underline; }

  .search-bar {
    margin: 12px 0 20px;
    position: relative;
  }
  .search-bar input { padding-right: 80px; }
  .search-count {
    position: absolute;
    right: 12px;
    top: 50%;
    transform: translateY(-50%);
    font-size: 12px;
    color: var(--text-dim);
  }

  .chapter-list { padding-bottom: 40px; }
  .loading {
    padding: 40px 0;
    text-align: center;
    color: var(--text-tertiary);
    font-size: 13px;
  }
  .chapter-item {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 14px 0;
    border-bottom: 1px solid var(--border);
    cursor: pointer;
    transition: opacity 0.2s;
  }
  .chapter-item:hover { opacity: 0.6; }
  .chapter-item:last-child { border-bottom: none; }
  .chapter-info {
    display: flex;
    align-items: center;
    gap: 14px;
    min-width: 0;
  }
  .chapter-num {
    font-size: 12px;
    color: var(--text-tertiary);
    font-variant-numeric: tabular-nums;
    min-width: 28px;
  }
  .chapter-title {
    font-size: 14px;
    color: var(--text);
    white-space: nowrap;
    overflow: hidden;
    text-overflow: ellipsis;
  }
  .chapter-meta {
    display: flex;
    align-items: center;
    gap: 12px;
    flex-shrink: 0;
  }
  .bookmarked {
    font-size: 11px;
    color: var(--accent);
    letter-spacing: 0.05em;
  }
  .chapter-date {
    font-size: 12px;
    color: var(--text-dim);
    font-variant-numeric: tabular-nums;
  }
</style>
