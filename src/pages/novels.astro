---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
---

<Layout title="目录 - 冰箱里的世界">
  <Header />
  
  <main class="container">
    <!-- 公告栏 -->
    <div class="notice" id="notice">
      <span class="notice-label">公告</span>
      <span class="notice-content" id="noticeContent">加载中...</span>
    </div>

    <div class="hero">
      <h1>目录</h1>
      <p>会员专属阅读区</p>
      <div class="last-read" id="lastRead"></div>
    </div>
    
    <!-- 搜索栏 -->
    <div class="search-bar">
      <input type="text" id="searchInput" placeholder="搜索章节标题..." />
      <span class="search-count" id="searchCount"></span>
    </div>

    <div class="chapter-list" id="chapterList">
      <div class="empty">加载中...</div>
    </div>
  </main>

  <footer class="container">
    <p>2026 冰箱里的世界 · 仅供会员阅读</p>
  </footer>
</Layout>

<script type="module">
  import { 
    getChapters, getAnnouncement, getBookmarks, getSession 
  } from '/lib/supabase.js';
  import { debounce, highlightText } from '/lib/utils.js';
  
  // 检查认证
  const session = await getSession();
  if (!session) {
    window.location.href = '/login';
  }
  
  let allChapters = [];
  let bookmarksMap = new Set();
  
  async function loadData() {
    // 加载公告
    const noticeText = await getAnnouncement();
    document.getElementById('noticeContent').textContent = noticeText;
    
    // 加载章节
    const { data: chapters, error } = await getChapters();
    allChapters = chapters || [];
    
    if (error) {
      document.getElementById('chapterList').innerHTML = '<div class="empty">加载失败</div>';
      return;
    }
    
    // 加载书签
    const { data: bookmarks } = await getBookmarks();
    bookmarksMap = new Set((bookmarks || []).map(b => b.chapter_id));
    
    // 显示继续阅读
    const lastChapterId = localStorage.getItem('last_read_chapter');
    if (lastChapterId) {
      const lastChapter = allChapters.find(c => c.id === lastChapterId);
      if (lastChapter) {
        document.getElementById('lastRead').innerHTML = `
          <a href="/read?id=${lastChapterId}" class="btn btn-primary">
            继续阅读：第${lastChapter.order_num}章 ${lastChapter.title}
          </a>
        `;
      }
    }
    
    renderChapters(allChapters);
  }
  
  function renderChapters(chapters, keyword = '') {
    const list = document.getElementById('chapterList');
    const countEl = document.getElementById('searchCount');
    
    if (!chapters || chapters.length === 0) {
      list.innerHTML = '<div class="empty">暂无章节</div>';
      countEl.textContent = '';
      return;
    }
    
    countEl.textContent = keyword ? `找到 ${chapters.length} 个结果` : `共 ${chapters.length} 章`;
    
    list.innerHTML = chapters.map(c => {
      const isBookmarked = bookmarksMap.has(c.id);
      const titleHtml = keyword ? highlightText(c.title, keyword) : c.title;
      
      return `
        <div class="chapter-item" onclick="location.href='/read?id=${c.id}'">
          <div class="chapter-main">
            <h3>第${c.order_num}章 · ${titleHtml}</h3>
            <div class="meta">${new Date(c.created_at).toLocaleDateString('zh-CN')}</div>
          </div>
          ${isBookmarked ? '<span class="bookmark-badge" title="已收藏">★</span>' : ''}
        </div>
      `;
    }).join('');
  }
  
  // 搜索功能
  const searchInput = document.getElementById('searchInput');
  searchInput?.addEventListener('input', debounce((e) => {
    const keyword = e.target.value.trim().toLowerCase();
    if (!keyword) {
      renderChapters(allChapters);
      return;
    }
    
    const filtered = allChapters.filter(c => 
      c.title.toLowerCase().includes(keyword) ||
      c.order_num.toString().includes(keyword)
    );
    renderChapters(filtered, keyword);
  }, 200));
  
  loadData();
</script>

<style>
  .notice {
    background: var(--bg-secondary);
    border: 1px solid var(--border-color);
    border-radius: 8px;
    padding: 1.25rem 1.5rem;
    margin: 2rem 0;
    display: flex;
    align-items: flex-start;
    gap: 1rem;
  }

  .notice-label {
    font-size: 0.75rem;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.1em;
    white-space: nowrap;
    padding-top: 0.125rem;
  }

  .notice-content {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.6;
  }

  .hero {
    padding: 2rem 0 1.5rem;
  }

  .hero h1 {
    font-size: 1.75rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }

  .hero p {
    font-size: 0.875rem;
    color: var(--text-dim);
  }

  .last-read {
    margin-top: 1.5rem;
  }
  
  .search-bar {
    margin: 1.5rem 0;
    position: relative;
  }
  
  .search-bar input {
    padding-right: 6rem;
  }
  
  .search-count {
    position: absolute;
    right: 1rem;
    top: 50%;
    transform: translateY(-50%);
    font-size: 0.75rem;
    color: var(--text-faint);
    pointer-events: none;
  }

  .chapter-list {
    padding-bottom: 4rem;
  }

  .chapter-item {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-color);
    cursor: pointer;
    transition: opacity 0.2s;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  .chapter-item:last-child {
    border-bottom: none;
  }

  .chapter-item:hover {
    opacity: 0.7;
  }

  .chapter-item h3 {
    font-size: 1rem;
    font-weight: 500;
    color: var(--text-primary);
    margin-bottom: 0.25rem;
  }

  .chapter-item .meta {
    font-size: 0.75rem;
    color: var(--text-faint);
  }
  
  .bookmark-badge {
    color: #ca4;
    font-size: 0.875rem;
    margin-left: 0.5rem;
  }

  footer {
    padding: 2rem 0;
    text-align: center;
    font-size: 0.75rem;
    color: var(--text-faint);
    border-top: 1px solid var(--border-color);
  }
</style>
