---
const chapterId = Astro.url.searchParams.get('id');
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>阅读 - 冰箱里的世界</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: "Noto Serif SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", serif;
        background: #0a0a0a;
        color: #ccc;
        line-height: 2;
        font-size: 1.125rem;
      }

      .container {
        max-width: 680px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      header {
        padding: 1.5rem 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        background: #0a0a0a;
        border-bottom: 1px solid #111;
        z-index: 10;
      }

      .logo {
        font-size: 0.875rem;
        font-weight: 500;
        color: #fff;
        text-decoration: none;
        letter-spacing: 0.05em;
      }

      .nav a {
        color: #555;
        text-decoration: none;
        margin-left: 1.5rem;
        font-size: 0.875rem;
        transition: color 0.2s;
        cursor: pointer;
      }

      .nav a:hover { color: #fff; }

      .chapter-header {
        padding: 4rem 0 3rem;
        text-align: center;
        border-bottom: 1px solid #111;
        margin-bottom: 3rem;
      }

      .chapter-header h1 {
        font-size: 1.5rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 0.5rem;
      }

      .chapter-header .meta {
        font-size: 0.75rem;
        color: #444;
        font-family: "PingFang SC", sans-serif;
      }

      .chapter-content {
        padding-bottom: 4rem;
        white-space: pre-wrap;
        word-wrap: break-word;
      }

      .chapter-content p {
        margin-bottom: 1.5rem;
        text-indent: 2em;
      }

      .chapter-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 0;
        border-top: 1px solid #111;
        border-bottom: 1px solid #111;
        margin-bottom: 4rem;
      }

      .chapter-nav a {
        color: #555;
        text-decoration: none;
        font-size: 0.875rem;
        font-family: "PingFang SC", sans-serif;
        transition: color 0.2s;
        padding: 0.5rem 0;
      }

      .chapter-nav a:hover { color: #fff; }

      .chapter-nav a.disabled {
        color: #222;
        cursor: default;
        pointer-events: none;
      }

      .chapter-nav .center {
        color: #444;
        font-size: 0.75rem;
      }

      /* 评论区 */
      .comment-section {
        padding: 4rem 0 6rem;
        border-top: 1px solid #111;
      }

      .comment-section h2 {
        font-size: 1rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 2rem;
        font-family: "PingFang SC", sans-serif;
      }

      .comment-count {
        color: #555;
        font-weight: 400;
      }

      .comment-form {
        margin-bottom: 3rem;
      }

      .comment-textarea {
        width: 100%;
        padding: 1rem;
        background: #111;
        border: 1px solid #1a1a1a;
        border-radius: 6px;
        color: #fff;
        font-size: 0.9375rem;
        font-family: inherit;
        outline: none;
        resize: vertical;
        min-height: 100px;
        margin-bottom: 1rem;
      }

      .comment-textarea::placeholder { color: #444; }
      .comment-textarea:focus { border-color: #333; }

      .comment-submit {
        padding: 0.75rem 2rem;
        background: #fff;
        color: #0a0a0a;
        border: none;
        border-radius: 6px;
        font-size: 0.875rem;
        font-weight: 500;
        cursor: pointer;
        transition: opacity 0.2s;
      }

      .comment-submit:hover { opacity: 0.85; }
      .comment-submit:disabled { background: #222; color: #555; }

      .comment-list { display: flex; flex-direction: column; gap: 1.5rem; }

      .comment-item {
        padding: 1.5rem;
        background: #111;
        border: 1px solid #1a1a1a;
        border-radius: 8px;
      }

      .comment-header {
        display: flex;
        justify-content: space-between;
        align-items: center;
        margin-bottom: 0.75rem;
      }

      .comment-author {
        font-size: 0.875rem;
        color: #888;
        font-family: "PingFang SC", sans-serif;
      }

      .comment-time {
        font-size: 0.75rem;
        color: #444;
      }

      .comment-content {
        font-size: 0.9375rem;
        color: #ccc;
        line-height: 1.8;
        margin-bottom: 1rem;
      }

      .comment-actions {
        display: flex;
        gap: 1.5rem;
      }

      .comment-actions a {
        color: #555;
        text-decoration: none;
        font-size: 0.8125rem;
        font-family: "PingFang SC", sans-serif;
        transition: color 0.2s;
        cursor: pointer;
      }

      .comment-actions a:hover { color: #fff; }

      .reply-form {
        display: none;
        margin-top: 1rem;
        padding-top: 1rem;
        border-top: 1px solid #1a1a1a;
      }

      .reply-form.active { display: block; }

      .reply-input {
        width: 100%;
        padding: 0.75rem;
        background: #0a0a0a;
        border: 1px solid #222;
        border-radius: 6px;
        color: #fff;
        font-size: 0.875rem;
        font-family: inherit;
        outline: none;
        margin-bottom: 0.75rem;
      }

      .reply-input::placeholder { color: #444; }

      .reply-submit {
        padding: 0.5rem 1.25rem;
        background: #fff;
        color: #0a0a0a;
        border: none;
        border-radius: 6px;
        font-size: 0.8125rem;
        font-weight: 500;
        cursor: pointer;
      }

      .reply-submit:disabled { background: #222; color: #555; }

      .replies {
        margin-top: 1rem;
        padding-left: 1.5rem;
        border-left: 2px solid #1a1a1a;
        display: flex;
        flex-direction: column;
        gap: 1rem;
      }

      .reply-item {
        padding: 1rem;
        background: #0a0a0a;
        border-radius: 6px;
      }

      .reply-item .comment-header { margin-bottom: 0.5rem; }
      .reply-item .comment-content { margin-bottom: 0; font-size: 0.875rem; }

      .no-comments {
        text-align: center;
        padding: 3rem 0;
        color: #444;
        font-size: 0.875rem;
      }

      footer {
        padding: 3rem 0;
        text-align: center;
        font-size: 0.75rem;
        color: #222;
        border-top: 1px solid #111;
      }
    </style>
  </head>
  <body>
    <header class="container">
      <a href="/" class="logo">冰箱里的世界</a>
      <nav class="nav">
        <a href="/novels">目录</a>
        <a onclick="logout()">退出</a>
      </nav>
    </header>

    <main class="container">
      <div class="chapter-header">
        <h1 id="title">加载中</h1>
        <div class="meta" id="meta"></div>
      </div>

      <div class="chapter-content" id="content"></div>

      <div class="chapter-nav" id="chapterNav">
        <a href="#" id="prevLink">上一章</a>
        <span class="center" id="progress"></span>
        <a href="#" id="nextLink">下一章</a>
      </div>

      <div class="comment-section">
        <h2>评论 <span class="comment-count" id="commentCount"></span></h2>
        <div class="comment-form">
          <textarea class="comment-textarea" id="commentInput" placeholder="写下你的想法..."></textarea>
          <button class="comment-submit" id="submitBtn" onclick="submitComment()">发表评论</button>
        </div>
        <div class="comment-list" id="commentList">
          <div class="no-comments">加载中...</div>
        </div>
      </div>
    </main>

    <footer class="container">
      <p>2026 冰箱里的世界 · 仅供会员阅读</p>
    </footer>

    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.39.0';

      const SUPABASE_URL = 'https://cwkqlwdeteitisdrlwmg.supabase.co';
      const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN3a3Fsd2RldGVpdGlzZHJsd21nIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEyODkwMzMsImV4cCI6MjA5Njg2NTAzM30.hSbK_Z1rH9pXUwpfh2o5ZxbpkRUyy_7xDYcrmvLXgq8';
      const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

      const token = localStorage.getItem('sb_token');
      if (!token) {
        window.location.href = '/login';
      }

      let readerId = localStorage.getItem('reader_id');
      if (!readerId) {
        readerId = '读者#' + Math.floor(1000 + Math.random() * 9000);
        localStorage.setItem('reader_id', readerId);
      }

      const currentId = new URLSearchParams(window.location.search).get('id');
      if (!currentId) {
        window.location.href = '/novels';
      }

      let allChapters = [];
      let commentsData = [];

      async function loadChapter() {
        const { data: chapters } = await supabase
          .from('chapters')
          .select('id, order_num, title')
          .order('order_num', { ascending: true });

        allChapters = chapters || [];
        const currentIndex = allChapters.findIndex(c => c.id === currentId);

        const { data: chapter } = await supabase
          .from('chapters')
          .select('*')
          .eq('id', currentId)
          .single();

        if (!chapter) {
          document.getElementById('title').textContent = '章节不存在';
          return;
        }

        document.getElementById('title').textContent = `第${chapter.order_num}章 ${chapter.title}`;
        document.getElementById('meta').textContent = new Date(chapter.created_at).toLocaleDateString('zh-CN');

        const paragraphs = chapter.content.split('\n').filter(p => p.trim());
        document.getElementById('content').innerHTML = paragraphs.map(p => `<p>${p}</p>`).join('');

        const prevLink = document.getElementById('prevLink');
        const nextLink = document.getElementById('nextLink');

        if (currentIndex > 0) {
          prevLink.href = `/read?id=${allChapters[currentIndex - 1].id}`;
          prevLink.classList.remove('disabled');
        } else {
          prevLink.classList.add('disabled');
          prevLink.textContent = '已是第一章';
        }

        if (currentIndex < allChapters.length - 1) {
          nextLink.href = `/read?id=${allChapters[currentIndex + 1].id}`;
          nextLink.classList.remove('disabled');
        } else {
          nextLink.classList.add('disabled');
          nextLink.textContent = '已是最后一章';
        }

        document.getElementById('progress').textContent = `${currentIndex + 1} / ${allChapters.length}`;

        loadComments();
      }

      async function loadComments() {
        const { data: comments } = await supabase
          .from('comments')
          .select('*')
          .eq('chapter_id', currentId)
          .is('reply_to', null)
          .order('created_at', { ascending: false });

        const { data: replies } = await supabase
          .from('comments')
          .select('*')
          .eq('chapter_id', currentId)
          .not('reply_to', 'is', null)
          .order('created_at', { ascending: true });

        commentsData = comments || [];

        const replyMap = {};
        replies?.forEach(r => {
          if (!replyMap[r.reply_to]) replyMap[r.reply_to] = [];
          replyMap[r.reply_to].push(r);
        });

        document.getElementById('commentCount').textContent = `(${commentsData.length})`;

        const list = document.getElementById('commentList');
        if (!commentsData.length) {
          list.innerHTML = '<div class="no-comments">暂无评论，来说两句吧</div>';
          return;
        }

        list.innerHTML = commentsData.map(c => {
          const itemReplies = replyMap[c.id] || [];
          return renderComment(c, itemReplies);
        }).join('');
      }

      function renderComment(c, replies) {
        const replyHtml = replies.length ? `
          <div class="replies">
            ${replies.map(r => `
              <div class="reply-item">
                <div class="comment-header">
                  <span class="comment-author">${r.reader_id}</span>
                  <span class="comment-time">${new Date(r.created_at).toLocaleDateString('zh-CN')}</span>
                </div>
                <div class="comment-content">${escapeHtml(r.content)}</div>
              </div>
            `).join('')}
          </div>
        ` : '';

        return `
          <div class="comment-item" id="comment-${c.id}">
            <div class="comment-header">
              <span class="comment-author">${c.reader_id}</span>
              <span class="comment-time">${new Date(c.created_at).toLocaleDateString('zh-CN')}</span>
            </div>
            <div class="comment-content">${escapeHtml(c.content)}</div>
            <div class="comment-actions">
              <a onclick="showReplyForm('${c.id}')">回复</a>
            </div>
            <div class="reply-form" id="reply-form-${c.id}">
              <input type="text" class="reply-input" id="reply-input-${c.id}" placeholder="回复 ${c.reader_id}..." />
              <button class="reply-submit" onclick="submitReply('${c.id}')">发送</button>
            </div>
            ${replyHtml}
          </div>
        `;
      }

      window.submitComment = async function() {
        const input = document.getElementById('commentInput');
        const content = input.value.trim();
        if (!content) return;

        const btn = document.getElementById('submitBtn');
        btn.disabled = true;
        btn.textContent = '发表中';

        const { error } = await supabase
          .from('comments')
          .insert([{
            chapter_id: currentId,
            reader_id: readerId,
            content: content
          }]);

        if (error) {
          alert('发送失败：' + error.message);
          btn.disabled = false;
          btn.textContent = '发表评论';
          return;
        }

        input.value = '';
        btn.disabled = false;
        btn.textContent = '发表评论';
        loadComments();
      };

      window.showReplyForm = function(commentId) {
        const form = document.getElementById(`reply-form-${commentId}`);
        form.classList.toggle('active');
        if (form.classList.contains('active')) {
          document.getElementById(`reply-input-${commentId}`).focus();
        }
      };

      window.submitReply = async function(parentId) {
        const input = document.getElementById(`reply-input-${parentId}`);
        const content = input.value.trim();
        if (!content) return;

        const { error } = await supabase
          .from('comments')
          .insert([{
            chapter_id: currentId,
            reader_id: readerId,
            content: content,
            reply_to: parentId
          }]);

        if (error) {
          alert('回复失败：' + error.message);
          return;
        }

        loadComments();
      };

      function escapeHtml(text) {
        const div = document.createElement('div');
        div.textContent = text;
        return div.innerHTML;
      }

      window.logout = function() {
        localStorage.removeItem('sb_token');
        window.location.href = '/';
      };

      loadChapter();
    </script>
  </body>
</html>