---
const chapterId = Astro.url.searchParams.get('id');
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>阅读 - 冰箱里的世界</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body {
        font-family: -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, "Noto Serif SC", serif;
        background: #faf9f7;
        color: #333;
        line-height: 1.8;
      }
      .container { max-width: 700px; margin: 0 auto; padding: 0 1.5rem; }
      
      header {
        padding: 1.5rem 0;
        border-bottom: 1px solid #e5e5e5;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        background: #faf9f7;
      }
      .logo { font-size: 1.25rem; font-weight: 600; color: #222; text-decoration: none; }
      .nav a { color: #666; text-decoration: none; margin-left: 1.5rem; font-size: 0.875rem; }
      
      .chapter-title {
        text-align: center;
        padding: 3rem 0 2rem;
        font-size: 1.75rem;
        font-weight: 600;
      }
      
      .chapter-content {
        font-size: 1.125rem;
        line-height: 2;
        color: #444;
        padding-bottom: 4rem;
        white-space: pre-wrap;
      }
      
      .nav-bottom {
        display: flex;
        justify-content: space-between;
        padding: 2rem 0 4rem;
        border-top: 1px solid #e5e5e5;
      }
      .nav-bottom a {
        color: #666;
        text-decoration: none;
        font-size: 0.875rem;
      }
      .nav-bottom a:hover { color: #1a1a1a; }
      
      footer {
        text-align: center;
        padding: 2rem 0;
        border-top: 1px solid #e5e5e5;
        color: #999;
        font-size: 0.875rem;
      }
    </style>
  </head>
  <body>
    <header class="container">
      <a href="/" class="logo">📚 冰箱里的世界</a>
      <nav class="nav">
        <a href="/novels">目录</a>
        <a href="#" onclick="logout()">退出</a>
      </nav>
    </header>
    
    <main class="container">
      <h1 class="chapter-title" id="title">加载中...</h1>
      <div class="chapter-content" id="content">请稍候...</div>
      
      <div class="nav-bottom">
        <a href="/novels">← 返回目录</a>
      </div>
    </main>
    
    <footer>
      <div class="container">
        <p>© 2026 冰箱里的世界 · 仅供会员阅读</p>
      </div>
    </footer>
    
    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.39.0';
      
      const SUPABASE_URL = 'https://cwkqlwdeteitisdrlwmg.supabase.co';
      const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN3a3Fsd2RldGVpdGlzZHJsd21nIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEyODkwMzMsImV4cCI6MjA5Njg2NTAzM30.hSbK_Z1rH9pXUwpfh2o5ZxbpkRUyy_7xDYcrmvLXgq8';
      const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);
      
      // 检查登录
      const token = localStorage.getItem('sb_token');
      if (!token) {
        window.location.href = '/login';
      }
      
      const chapterId = new URLSearchParams(window.location.search).get('id');
      if (!chapterId) {
        window.location.href = '/novels';
      }
      
      async function loadChapter() {
        const { data: chapter, error } = await supabase
          .from('chapters')
          .select('*')
          .eq('id', chapterId)
          .single();
        
        if (error || !chapter) {
          document.getElementById('title').textContent = '章节不存在';
          document.getElementById('content').textContent = '';
          return;
        }
        
        document.getElementById('title').textContent = `第${chapter.order_num}章 ${chapter.title}`;
        document.getElementById('content').textContent = chapter.content;
      }
      
      window.logout = function() {
        localStorage.removeItem('sb_token');
        window.location.href = '/';
      };
      
      loadChapter();
    </script>
  </body>
</html>