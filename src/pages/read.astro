---
import Layout from '../layouts/Layout.astro';
import ReaderHeader from '../components/ReaderHeader.astro';

const chapterId = Astro.url.searchParams.get('id');
---

<Layout title="阅读">
  <ReaderHeader />

  <main class="container-reader" id="readerMain">
    <div class="toolbar">
      <div class="toolbar-group">
        <label>字号</label>
        <div class="btn-group">
          <button class="btn-tune" data-font="-0.125">-</button>
          <button class="btn-tune" data-font="+0.125">+</button>
        </div>
      </div>
      <div class="toolbar-group">
        <label>行距</label>
        <div class="btn-group">
          <button class="btn-tune" data-line="-0.2">窄</button>
          <button class="btn-tune" data-line="+0.2">宽</button>
        </div>
      </div>
      <div class="toolbar-group">
        <label>字体</label>
        <div class="btn-group">
          <button class="btn-tune" data-font-family="serif">宋</button>
          <button class="btn-tune" data-font-family="sans">黑</button>
        </div>
      </div>
      <div class="toolbar-group">
        <label>宽度</label>
        <div class="btn-group">
          <button class="btn-tune" data-width="narrow">窄</button>
          <button class="btn-tune" data-width="normal">中</button>
          <button class="btn-tune" data-width="wide">宽</button>
        </div>
      </div>
      <button class="btn-tune bookmark-btn" id="bookmarkBtn">
        <span id="bookmarkIcon">收藏</span>
      </button>
    </div>

    <article class="chapter">
      <header class="chapter-header">
        <div class="chapter-label" id="chapterMetaLabel"></div>
        <h1 id="title">加载中</h1>
        <div class="chapter-date" id="meta"></div>
      </header>

      <div class="chapter-body" id="content">
        <p class="loading-text">加载中...</p>
      </div>
    </article>

    <nav class="chapter-nav" id="chapterNav">
      <a href="#" id="prevLink" class="nav-link">上一章</a>
      <span class="nav-progress" id="progress"></span>
      <a href="#" id="nextLink" class="nav-link">下一章</a>
    </nav>

    <section class="comments">
      <h3 class="comments-title">评论</h3>
      <form class="comment-form" id="commentForm">
        <textarea id="commentInput" placeholder="写下你的想法..." rows="3"></textarea>
        <button type="submit" class="btn btn-primary btn-small" id="commentBtn">发表</button>
      </form>
      <div class="comments-list" id="commentsList">
        <div class="empty">加载中...</div>
      </div>
    </section>
  </main>

  <footer class="container-reader site-footer">
    <p>2026 冰箱里的世界 · 仅供会员阅读</p>
  </footer>
</Layout>

<script type="module">
  import {
    getChapters, getChapter, getSession,
    saveProgress, getProgress,
    toggleBookmark, getBookmarks,
    getComments, addComment, deleteComment,
    checkIsAdmin, adminDeleteComment
  } from '/lib/supabase.js';
  import { throttle, formatDate } from '/lib/utils.js';

  const session = await getSession();
  if (!session) window.location.href = '/login';

  const currentId = new URLSearchParams(window.location.search).get('id');
  if (!currentId) window.location.href = '/novels';
  localStorage.setItem('last_read_chapter', currentId);

  let fontSize = parseFloat(localStorage.getItem('reader_font_size')) || 1.125;
  let lineHeight = parseFloat(localStorage.getItem('reader_line_height')) || 2;
  let fontFamily = localStorage.getItem('reader_font_family') || 'serif';
  let pageWidth = localStorage.getItem('reader_page_width') || 'normal';
  let allChapters = [];
  let isBookmarked = false;
  let myUserId = session?.user?.id;
  let isAdmin = false;

  try { isAdmin = await checkIsAdmin(); } catch(e) {}

  function applySettings() {
    const content = document.getElementById('content');
    const main = document.querySelector('main');
    if (!content) return;
    content.style.fontSize = fontSize + 'rem';
    content.style.lineHeight = lineHeight;
    content.style.fontFamily = fontFamily === 'serif'
      ? 'var(--font-serif)'
      : 'var(--font)';
    if (main) {
      main.classList.remove('container-reader', 'container-narrow', 'container-wide');
      if (pageWidth === 'narrow') main.classList.add('container-narrow');
      else if (pageWidth === 'wide') main.classList.add('container-wide');
      else main.classList.add('container-reader');
    }
  }

  document.querySelectorAll('.btn-tune').forEach(btn => {
    btn.addEventListener('click', () => {
      const fontDelta = parseFloat(btn.dataset.font);
      const lineDelta = parseFloat(btn.dataset.line);
      const fontFam = btn.dataset.fontFamily;
      const width = btn.dataset.width;
      if (!isNaN(fontDelta)) { fontSize = Math.max(0.875, Math.min(1.5, fontSize + fontDelta)); localStorage.setItem('reader_font_size', fontSize); }
      if (!isNaN(lineDelta)) { lineHeight = Math.max(1.5, Math.min(3, lineHeight + lineDelta)); localStorage.setItem('reader_line_height', lineHeight); }
      if (fontFam) { fontFamily = fontFam; localStorage.setItem('reader_font_family', fontFamily); }
      if (width) { pageWidth = width; localStorage.setItem('reader_page_width', pageWidth); }
      applySettings();
    });
  });

  document.getElementById('bookmarkBtn')?.addEventListener('click', async () => {
    const btn = document.getElementById('bookmarkBtn');
    btn.disabled = true;
    const { bookmarked } = await toggleBookmark(currentId);
    isBookmarked = bookmarked;
    document.getElementById('bookmarkIcon').textContent = bookmarked ? '已收藏' : '收藏';
    btn.classList.toggle('active', bookmarked);
    btn.disabled = false;
  });

  async function loadChapter() {
    const { data: chapters } = await getChapters();
    allChapters = chapters || [];
    const currentIndex = allChapters.findIndex(c => c.id === currentId);
    const { data: chapter, error } = await getChapter(currentId);
    if (error || !chapter) {
      document.getElementById('title').textContent = '章节不存在';
      document.getElementById('content').innerHTML = '<div class="empty">章节不存在或已被删除</div>';
      return;
    }
    document.title = `第${chapter.order_num}章 ${chapter.title}`;
    document.getElementById('chapterMetaLabel').textContent = `第 ${chapter.order_num} 章`;
    document.getElementById('title').textContent = chapter.title;
    document.getElementById('meta').textContent = formatDate(chapter.created_at);
    const paragraphs = chapter.content.split('\n').filter(p => p.trim());
    document.getElementById('content').innerHTML = paragraphs.map(p => `<p>${escapeHtml(p)}</p>`).join('');
    applySettings();
    const savedProgress = await getProgress(currentId);
    if (savedProgress > 100) setTimeout(() => window.scrollTo({ top: savedProgress, behavior: 'smooth' }), 300);
    const prevLink = document.getElementById('prevLink');
    const nextLink = document.getElementById('nextLink');
    if (currentIndex > 0) { prevLink.href = `/read?id=${allChapters[currentIndex - 1].id}`; prevLink.classList.remove('disabled'); }
    else { prevLink.classList.add('disabled'); prevLink.href = '#'; }
    if (currentIndex < allChapters.length - 1) { nextLink.href = `/read?id=${allChapters[currentIndex + 1].id}`; nextLink.classList.remove('disabled'); }
    else { nextLink.classList.add('disabled'); nextLink.href = '#'; }
    document.getElementById('progress').textContent = `${currentIndex + 1} / ${allChapters.length}`;
    const { data: bookmarks } = await getBookmarks();
    isBookmarked = (bookmarks || []).some(b => b.chapter_id === currentId);
    document.getElementById('bookmarkIcon').textContent = isBookmarked ? '已收藏' : '收藏';
    document.getElementById('bookmarkBtn').classList.toggle('active', isBookmarked);
    loadComments();
  }

  const throttledSaveProgress = throttle(async () => {
    if (!currentId) return;
    const scrollY = window.scrollY;
    if (scrollY > 100) await saveProgress(currentId, scrollY);
  }, 5000);
  window.addEventListener('scroll', throttledSaveProgress);

  async function loadComments() {
    const list = document.getElementById('commentsList');
    const { data: comments, error } = await getComments(currentId);
    if (error) { list.innerHTML = '<div class="empty">加载失败</div>'; return; }
    if (!comments || comments.length === 0) { list.innerHTML = '<div class="empty">暂无评论</div>'; return; }
    list.innerHTML = comments.map(c => `
      <div class="comment-item" data-id="${c.id}">
        <div class="comment-header">
          <span class="comment-author">${escapeHtml(c.reader_id)}</span>
          <span class="comment-time">${formatDate(c.created_at)}</span>
          ${(c.user_id === myUserId || isAdmin) ? `<button class="comment-delete" data-id="${c.id}">删除</button>` : ''}
        </div>
        <div class="comment-body">${escapeHtml(c.content)}</div>
      </div>
    `).join('');
    list.querySelectorAll('.comment-delete').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        if (!confirm('确定删除？')) return;
        const commentId = btn.dataset.id;
        const commentData = comments.find(c => c.id === commentId);
        if (commentData?.user_id === myUserId) await deleteComment(commentId);
        else if (isAdmin) await adminDeleteComment(commentId);
        loadComments();
      });
    });
  }

  document.getElementById('commentForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('commentBtn');
    const input = document.getElementById('commentInput');
    const content = input.value.trim();
    if (!content) return;
    btn.disabled = true;
    btn.textContent = '发表中...';
    const { error } = await addComment(currentId, content);
    if (error) alert('评论失败：' + error.message);
    else { input.value = ''; loadComments(); }
    btn.disabled = false;
    btn.textContent = '发表';
  });

  function escapeHtml(text) { const div = document.createElement('div'); div.textContent = text; return div.innerHTML; }
  loadChapter();
</script>

<style>
  .toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 16px;
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
    margin-bottom: 40px;
    font-size: 12px;
    color: var(--text-tertiary);
    align-items: center;
  }
  .toolbar-group { display: flex; align-items: center; gap: 6px; }
  .toolbar-group label { white-space: nowrap; }
  .btn-group { display: flex; gap: 4px; }
  .btn-tune {
    background: transparent;
    border: 1px solid var(--border);
    color: var(--text-secondary);
    padding: 3px 10px;
    border-radius: 4px;
    cursor: pointer;
    font-size: 12px;
    font-family: inherit;
    transition: all 0.2s;
  }
  .btn-tune:hover { border-color: var(--border-hover); color: var(--text); }
  .bookmark-btn { margin-left: auto; }
  .bookmark-btn.active { color: var(--accent); border-color: var(--accent); }

  .chapter-header {
    padding: 32px 0 40px;
    text-align: center;
    border-bottom: 1px solid var(--border);
    margin-bottom: 40px;
  }
  .chapter-label {
    font-size: 12px;
    color: var(--accent);
    letter-spacing: 0.1em;
    margin-bottom: 12px;
  }
  .chapter-header h1 {
    font-size: 24px;
    font-weight: 600;
    margin-bottom: 8px;
    letter-spacing: -0.01em;
  }
  .chapter-date {
    font-size: 12px;
    color: var(--text-tertiary);
    letter-spacing: 0.05em;
  }

  .chapter-body {
    padding-bottom: 48px;
    font-family: var(--font-serif);
  }
  .chapter-body p {
    margin-bottom: 1.75em;
    text-indent: 2em;
    line-height: inherit;
  }
  .loading-text {
    text-align: center;
    color: var(--text-tertiary);
    text-indent: 0;
  }

  .container-narrow { max-width: 480px; margin: 0 auto; padding: 0 24px; }
  .container-wide { max-width: 780px; margin: 0 auto; padding: 0 24px; }

  .chapter-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 24px 0;
    border-top: 1px solid var(--border);
    border-bottom: 1px solid var(--border);
    margin-bottom: 48px;
  }
  .nav-link {
    color: var(--text-secondary);
    text-decoration: none;
    font-size: 14px;
    transition: color 0.2s;
  }
  .nav-link:hover { color: var(--text); }
  .nav-link.disabled { color: var(--text-dim); pointer-events: none; }
  .nav-progress { font-size: 12px; color: var(--text-tertiary); }

  .comments { margin-bottom: 48px; }
  .comments-title {
    font-size: 16px;
    font-weight: 500;
    margin-bottom: 20px;
  }
  .comment-form { margin-bottom: 24px; }
  .comment-form textarea { margin-bottom: 10px; }
  .comments-list { display: flex; flex-direction: column; gap: 2px; }
  .comment-item {
    padding: 16px 0;
    border-bottom: 1px solid var(--border);
  }
  .comment-item:last-child { border-bottom: none; }
  .comment-header {
    display: flex;
    align-items: center;
    gap: 10px;
    margin-bottom: 6px;
  }
  .comment-author {
    font-size: 13px;
    font-weight: 500;
    color: var(--accent);
  }
  .comment-time {
    font-size: 11px;
    color: var(--text-tertiary);
  }
  .comment-delete {
    margin-left: auto;
    background: none;
    border: none;
    color: var(--text-dim);
    font-size: 11px;
    cursor: pointer;
    padding: 2px 6px;
    transition: color 0.2s;
  }
  .comment-delete:hover { color: #ef4444; }
  .comment-body {
    font-size: 14px;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  @media (max-width: 640px) {
    .container-reader, .container-narrow, .container-wide { padding: 0 18px; }
    .chapter-header h1 { font-size: 20px; }
    .toolbar { gap: 12px; }
  }
</style>
