---
const chapterId = Astro.url.searchParams.get('id');
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>阅读 - 冰箱里的世界</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: "Noto Serif SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", serif;
        background: #0a0a0a;
        color: #ccc;
        line-height: 2;
        font-size: 1.125rem;
      }
      
      .container {
        max-width: 680px;
        margin: 0 auto;
        padding: 0 2rem;
      }
      
      header {
        padding: 1.5rem 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        background: #0a0a0a;
        border-bottom: 1px solid #111;
        z-index: 10;
      }
      
      .logo {
        font-size: 0.875rem;
        font-weight: 500;
        color: #fff;
        text-decoration: none;
        letter-spacing: 0.05em;
      }
      
      .nav a {
        color: #555;
        text-decoration: none;
        margin-left: 1.5rem;
        font-size: 0.875rem;
        transition: color 0.2s;
        cursor: pointer;
      }
      
      .nav a:hover {
        color: #fff;
      }
      
      .chapter-header {
        padding: 4rem 0 3rem;
        text-align: center;
        border-bottom: 1px solid #111;
        margin-bottom: 3rem;
      }
      
      .chapter-header h1 {
        font-size: 1.5rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 0.5rem;
      }
      
      .chapter-header .meta {
        font-size: 0.75rem;
        color: #444;
        font-family: "PingFang SC", sans-serif;
      }
      
      .chapter-content {
        padding-bottom: 6rem;
        white-space: pre-wrap;
        word-wrap: break-word;
      }
      
      .chapter-content p {
        margin-bottom: 1.5rem;
        text-indent: 2em;
      }
      
      .nav-bottom {
        display: flex;
        justify-content: space-between;
        padding: 2rem 0 4rem;
        border-top: 1px solid #111;
      }
      
      .nav-bottom a {
        color: #555;
        text-decoration: none;
        font-size: 0.875rem;
        font-family: "PingFang SC", sans-serif;
        transition: color 0.2s;
      }
      
      .nav-bottom a:hover {
        color: #fff;
      }
      
      footer {
        padding: 3rem 0;
        text-align: center;
        font-size: 0.75rem;
        color: #222;
        border-top: 1px solid #111;
      }
    </style>
  </head>
  <body>
    <header class="container">
      <a href="/" class="logo">冰箱里的世界</a>
      <nav class="nav">
        <a href="/novels">目录</a>
        <a onclick="logout()">退出</a>
      </nav>
    </header>
    
    <main class="container">
      <div class="chapter-header">
        <h1 id="title">加载中...</h1>
        <div class="meta" id="meta"></div>
      </div>
      
      <div class="chapter-content" id="content"></div>
      
      <div class="nav-bottom">
        <a href="/novels">← 返回目录</a>
      </div>
    </main>
    
    <footer class="container">
      <p>© 2026 冰箱里的世界 · 仅供会员阅读</p>
    </footer>
    
    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.39.0';
      
      const SUPABASE_URL = 'https://cwkqlwdeteitisdrlwmg.supabase.co';
      const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN3a3Fsd2RldGVpdGlzZHJsd21nIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEyODkwMzMsImV4cCI6MjA5Njg2NTAzM30.hSbK_Z1rH9pXUwpfh2o5ZxbpkRUyy_7xDYcrmvLXgq8';
      const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);
      
      const token = localStorage.getItem('sb_token');
      if (!token) {
        window.location.href = '/login';
      }
      
      const chapterId = new URLSearchParams(window.location.search).get('id');
      if (!chapterId) {
        window.location.href = '/novels';
      }
      
      async function loadChapter() {
        const { data: chapter, error } = await supabase
          .from('chapters')
          .select('*')
          .eq('id', chapterId)
          .single();
        
        if (error || !chapter) {
          document.getElementById('title').textContent = '章节不存在';
          return;
        }
        
        document.getElementById('title').textContent = `第${chapter.order_num}章 · ${chapter.title}`;
        document.getElementById('meta').textContent = new Date(chapter.created_at).toLocaleDateString('zh-CN');
        
        // 把内容按段落分割，每段包一个 <p>
        const paragraphs = chapter.content.split('\n').filter(p => p.trim());
        document.getElementById('content').innerHTML = paragraphs.map(p => `<p>${p}</p>`).join('');
      }
      
      window.logout = function() {
        localStorage.removeItem('sb_token');
        window.location.href = '/';
      };
      
      loadChapter();
    </script>
  </body>
</html>