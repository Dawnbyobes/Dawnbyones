---
import Layout from '../layouts/Layout.astro';
import ReaderHeader from '../components/ReaderHeader.astro';

const chapterId = Astro.url.searchParams.get('id');
---

<Layout title="阅读 - 冰箱里的世界">
  <ReaderHeader />

  <main class="container-reader" id="readerMain">
    <!-- 阅读工具栏 -->
    <div class="reader-toolbar animate-fade-in-up">
      <div class="toolbar-group">
        <label>字号</label>
        <div class="btn-group">
          <button class="btn-tune" data-font="-0.125" title="减小字号">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
          <button class="btn-tune" data-font="+0.125" title="增大字号">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="12" y1="5" x2="12" y2="19"/><line x1="5" y1="12" x2="19" y2="12"/></svg>
          </button>
        </div>
      </div>
      <div class="toolbar-group">
        <label>行距</label>
        <div class="btn-group">
          <button class="btn-tune" data-line="-0.2" title="减小行距">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="6" x2="21" y2="6"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="18" x2="21" y2="18"/></svg>
          </button>
          <button class="btn-tune" data-line="+0.2" title="增大行距">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><line x1="3" y1="5" x2="21" y2="5"/><line x1="3" y1="12" x2="21" y2="12"/><line x1="3" y1="19" x2="21" y2="19"/></svg>
          </button>
        </div>
      </div>
      <div class="toolbar-group">
        <label>字体</label>
        <div class="btn-group">
          <button class="btn-tune" data-font-family="serif">宋体</button>
          <button class="btn-tune" data-font-family="sans">黑体</button>
        </div>
      </div>
      <div class="toolbar-group">
        <label>页宽</label>
        <div class="btn-group">
          <button class="btn-tune" data-width="narrow">窄</button>
          <button class="btn-tune" data-width="normal">中</button>
          <button class="btn-tune" data-width="wide">宽</button>
        </div>
      </div>
      <div class="toolbar-divider"></div>
      <div class="toolbar-group">
        <button class="btn-tune bookmark-btn" id="bookmarkBtn" title="收藏本章">
          <span id="bookmarkIcon">☆</span>
          <span class="bookmark-label">收藏</span>
        </button>
      </div>
    </div>

    <!-- 章节头部 -->
    <div class="chapter-header animate-fade-in-up stagger-1">
      <div class="chapter-meta-label" id="chapterMetaLabel"></div>
      <h1 id="title">加载中</h1>
      <div class="meta" id="meta"></div>
    </div>

    <!-- 章节内容 -->
    <div class="chapter-content" id="content">
      <div class="skeleton-content">
        {Array.from({ length: 8 }).map(() => (
          <div class="skeleton-paragraph">
            <div class="skeleton-line"></div>
            <div class="skeleton-line"></div>
          </div>
        ))}
      </div>
    </div>

    <!-- 章节导航 -->
    <div class="chapter-nav" id="chapterNav">
      <a href="#" id="prevLink" class="nav-link">
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="15 18 9 12 15 6"/></svg>
        <span>上一章</span>
      </a>
      <span class="center" id="progress"></span>
      <a href="#" id="nextLink" class="nav-link">
        <span>下一章</span>
        <svg width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><polyline points="9 18 15 12 9 6"/></svg>
      </a>
    </div>

    <!-- 评论区 -->
    <div class="comments-section" id="commentsSection">
      <div class="comments-header">
        <h3>
          <svg width="18" height="18" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
            <path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/>
          </svg>
          评论
        </h3>
        <span class="comments-count" id="commentsCount"></span>
      </div>
      <form class="comment-form" id="commentForm">
        <textarea id="commentInput" placeholder="写下你的想法..." rows="3"></textarea>
        <div class="comment-form-actions">
          <button type="submit" class="btn btn-primary btn-small" id="commentBtn">
            <svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.375rem;">
              <line x1="22" y1="2" x2="11" y2="13"/>
              <polygon points="22 2 15 22 11 13 2 9 22 2"/>
            </svg>
            发表评论
          </button>
        </div>
      </form>
      <div class="comments-list" id="commentsList">
        <div class="empty">加载中...</div>
      </div>
    </div>
  </main>

  <footer class="container-reader">
    <div class="footer-line"></div>
    <p>2026 冰箱里的世界 · 仅供会员阅读</p>
  </footer>
</Layout>

<script type="module">
  import {
    getChapters, getChapter, getSession,
    saveProgress, getProgress,
    toggleBookmark, getBookmarks,
    getComments, addComment, deleteComment,
    checkIsAdmin, adminDeleteComment
  } from '/lib/supabase.js';
  import { throttle, formatDate } from '/lib/utils.js';

  const session = await getSession();
  if (!session) window.location.href = '/login';

  const currentId = new URLSearchParams(window.location.search).get('id');
  if (!currentId) window.location.href = '/novels';
  localStorage.setItem('last_read_chapter', currentId);

  let fontSize = parseFloat(localStorage.getItem('reader_font_size')) || 1.125;
  let lineHeight = parseFloat(localStorage.getItem('reader_line_height')) || 2;
  let fontFamily = localStorage.getItem('reader_font_family') || 'serif';
  let pageWidth = localStorage.getItem('reader_page_width') || 'normal';
  let allChapters = [];
  let isBookmarked = false;
  let myUserId = session?.user?.id;
  let isAdmin = false;

  try { isAdmin = await checkIsAdmin(); } catch(e) {}

  function applySettings() {
    const content = document.getElementById('content');
    const main = document.querySelector('main');
    if (!content) return;
    content.style.fontSize = fontSize + 'rem';
    content.style.lineHeight = lineHeight;
    content.style.fontFamily = fontFamily === 'serif'
      ? '"Noto Serif SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", serif'
      : '"Noto Sans SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", sans-serif';
    if (main) {
      main.classList.remove('container-reader', 'container-narrow', 'container-wide');
      if (pageWidth === 'narrow') main.classList.add('container-narrow');
      else if (pageWidth === 'wide') main.classList.add('container-wide');
      else main.classList.add('container-reader');
    }
  }

  document.querySelectorAll('.btn-tune').forEach(btn => {
    btn.addEventListener('click', () => {
      const fontDelta = parseFloat(btn.dataset.font);
      const lineDelta = parseFloat(btn.dataset.line);
      const fontFam = btn.dataset.fontFamily;
      const width = btn.dataset.width;
      if (!isNaN(fontDelta)) { fontSize = Math.max(0.875, Math.min(1.5, fontSize + fontDelta)); localStorage.setItem('reader_font_size', fontSize); }
      if (!isNaN(lineDelta)) { lineHeight = Math.max(1.5, Math.min(3, lineHeight + lineDelta)); localStorage.setItem('reader_line_height', lineHeight); }
      if (fontFam) { fontFamily = fontFam; localStorage.setItem('reader_font_family', fontFamily); }
      if (width) { pageWidth = width; localStorage.setItem('reader_page_width', pageWidth); }
      applySettings();
    });
  });

  document.getElementById('bookmarkBtn')?.addEventListener('click', async () => {
    const btn = document.getElementById('bookmarkBtn');
    btn.disabled = true;
    const { bookmarked } = await toggleBookmark(currentId);
    isBookmarked = bookmarked;
    document.getElementById('bookmarkIcon').textContent = bookmarked ? '★' : '☆';
    btn.classList.toggle('active', bookmarked);
    btn.disabled = false;
  });

  async function loadChapter() {
    const { data: chapters } = await getChapters();
    allChapters = chapters || [];
    const currentIndex = allChapters.findIndex(c => c.id === currentId);
    const { data: chapter, error } = await getChapter(currentId);
    if (error || !chapter) {
      document.getElementById('title').textContent = '章节不存在';
      document.getElementById('content').innerHTML = '<div class="empty">章节不存在或已被删除</div>';
      return;
    }
    document.title = `第${chapter.order_num}章 ${chapter.title} - 冰箱里的世界`;
    document.getElementById('chapterMetaLabel').textContent = `第 ${chapter.order_num} 章`;
    document.getElementById('title').textContent = chapter.title;
    document.getElementById('meta').textContent = formatDate(chapter.created_at);
    const paragraphs = chapter.content.split('\n').filter(p => p.trim());
    document.getElementById('content').innerHTML = paragraphs.map(p => `<p>${escapeHtml(p)}</p>`).join('');
    applySettings();
    const savedProgress = await getProgress(currentId);
    if (savedProgress > 100) setTimeout(() => window.scrollTo({ top: savedProgress, behavior: 'smooth' }), 300);
    const prevLink = document.getElementById('prevLink');
    const nextLink = document.getElementById('nextLink');
    if (currentIndex > 0) { prevLink.href = `/read?id=${allChapters[currentIndex - 1].id}`; prevLink.classList.remove('disabled'); prevLink.querySelector('span').textContent = '上一章'; }
    else { prevLink.classList.add('disabled'); prevLink.querySelector('span').textContent = '已是第一章'; prevLink.href = '#'; }
    if (currentIndex < allChapters.length - 1) { nextLink.href = `/read?id=${allChapters[currentIndex + 1].id}`; nextLink.classList.remove('disabled'); nextLink.querySelector('span').textContent = '下一章'; }
    else { nextLink.classList.add('disabled'); nextLink.querySelector('span').textContent = '已是最后一章'; nextLink.href = '#'; }
    document.getElementById('progress').textContent = `${currentIndex + 1} / ${allChapters.length}`;
    const { data: bookmarks } = await getBookmarks();
    isBookmarked = (bookmarks || []).some(b => b.chapter_id === currentId);
    document.getElementById('bookmarkIcon').textContent = isBookmarked ? '★' : '☆';
    document.getElementById('bookmarkBtn').classList.toggle('active', isBookmarked);
    loadComments();
  }

  const throttledSaveProgress = throttle(async () => {
    if (!currentId) return;
    const scrollY = window.scrollY;
    if (scrollY > 100) await saveProgress(currentId, scrollY);
  }, 5000);
  window.addEventListener('scroll', throttledSaveProgress);

  async function loadComments() {
    const list = document.getElementById('commentsList');
    const { data: comments, error } = await getComments(currentId);
    document.getElementById('commentsCount').textContent = comments?.length ? `${comments.length} 条` : '';
    if (error) { list.innerHTML = '<div class="empty">评论加载失败</div>'; return; }
    if (!comments || comments.length === 0) { list.innerHTML = '<div class="empty">暂无评论，来发表第一条吧</div>'; return; }
    list.innerHTML = comments.map((c, i) => `
      <div class="comment-item" data-id="${c.id}" style="animation-delay: ${i * 0.05}s">
        <div class="comment-header">
          <div class="comment-author-info">
            <span class="comment-author">${escapeHtml(c.reader_id)}</span>
            <span class="comment-time">${formatDate(c.created_at)}</span>
          </div>
          ${(c.user_id === myUserId || isAdmin) ? `<button class="comment-delete" data-id="${c.id}" title="删除">删除</button>` : ''}
        </div>
        <div class="comment-body">${escapeHtml(c.content)}</div>
      </div>
    `).join('');
    list.querySelectorAll('.comment-delete').forEach(btn => {
      btn.addEventListener('click', async (e) => {
        e.stopPropagation();
        if (!confirm('确定要删除这条评论吗？')) return;
        const commentId = btn.dataset.id;
        const commentData = comments.find(c => c.id === commentId);
        if (commentData?.user_id === myUserId) await deleteComment(commentId);
        else if (isAdmin) await adminDeleteComment(commentId);
        loadComments();
      });
    });
  }

  document.getElementById('commentForm')?.addEventListener('submit', async (e) => {
    e.preventDefault();
    const btn = document.getElementById('commentBtn');
    const input = document.getElementById('commentInput');
    const content = input.value.trim();
    if (!content) return;
    btn.disabled = true;
    btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.375rem; animation: spin 0.6s linear infinite;"><polyline points="23 4 23 10 17 10"/></svg>发表中...`;
    const { error } = await addComment(currentId, content);
    if (error) alert('评论失败：' + error.message);
    else { input.value = ''; loadComments(); }
    btn.disabled = false;
    btn.innerHTML = `<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" style="margin-right: 0.375rem;"><line x1="22" y1="2" x2="11" y2="13"/><polygon points="22 2 15 22 11 13 2 9 22 2"/></svg>发表评论`;
  });

  function escapeHtml(text) { const div = document.createElement('div'); div.textContent = text; return div.innerHTML; }
  loadChapter();
</script>

<style>
  /* 阅读工具栏 */
  .reader-toolbar {
    display: flex;
    flex-wrap: wrap;
    gap: 1.25rem;
    padding: 1.25rem 0;
    border-bottom: 1.5px solid var(--border-color);
    margin-bottom: 2.5rem;
    font-size: 0.8125rem;
    color: var(--text-dim);
    align-items: center;
  }

  .toolbar-group { display: flex; align-items: center; gap: 0.625rem; }
  .toolbar-group label { color: var(--text-muted); white-space: nowrap; font-size: 0.75rem; letter-spacing: 0.05em; }
  .btn-group { display: flex; gap: 0.375rem; }

  .btn-tune {
    background: var(--bg-tertiary);
    border: 1.5px solid var(--border-color);
    color: var(--text-muted);
    padding: 0.375rem 0.75rem;
    border-radius: 8px;
    cursor: pointer;
    font-size: 0.75rem;
    font-family: inherit;
    transition: all 0.3s ease;
    display: inline-flex;
    align-items: center;
    gap: 0.25rem;
  }

  .btn-tune:hover {
    border-color: var(--accent-dim);
    color: var(--accent-light);
    background: var(--accent-pale);
    box-shadow: 0 0 12px var(--accent-glow);
  }

  .btn-tune:active {
    transform: scale(0.95);
  }

  .bookmark-btn {
    display: inline-flex;
    align-items: center;
    gap: 0.375rem;
    padding: 0.5rem 1rem;
    font-size: 0.8125rem;
  }

  .bookmark-btn.active {
    color: var(--accent-light);
    border-color: var(--accent-dim);
    background: var(--accent-pale);
    box-shadow: 0 0 16px var(--accent-glow);
  }

  .bookmark-label {
    font-size: 0.75rem;
  }

  .toolbar-divider {
    width: 1px;
    height: 24px;
    background: var(--border-color);
    margin: 0 0.25rem;
  }

  /* 骨架屏内容 */
  .skeleton-content {
    display: flex;
    flex-direction: column;
    gap: 1.5rem;
    padding: 2rem 0;
  }

  .skeleton-paragraph {
    display: flex;
    flex-direction: column;
    gap: 0.75rem;
  }

  .skeleton-paragraph .skeleton-line {
    height: 16px;
    border-radius: 8px;
    background: linear-gradient(90deg, var(--bg-tertiary) 25%, var(--bg-hover) 50%, var(--bg-tertiary) 75%);
    background-size: 200% 100%;
    animation: shimmer 1.5s infinite;
  }

  .skeleton-paragraph:last-child .skeleton-line:last-child {
    width: 60%;
  }

  /* 章节头部 */
  .chapter-header {
    padding: 2rem 0 3rem;
    text-align: center;
    border-bottom: 1.5px solid var(--border-color);
    margin-bottom: 3rem;
  }

  .chapter-meta-label {
    display: inline-block;
    padding: 0.375rem 1rem;
    background: var(--accent-pale);
    border: 1px solid rgba(124, 58, 237, 0.15);
    border-radius: 100px;
    font-size: 0.75rem;
    color: var(--accent-light);
    letter-spacing: 0.1em;
    margin-bottom: 1.25rem;
    font-weight: 500;
  }

  .chapter-header h1 {
    font-size: 1.75rem;
    font-weight: 700;
    color: var(--text-primary);
    margin-bottom: 0.75rem;
    letter-spacing: -0.02em;
    line-height: 1.3;
  }

  .chapter-header .meta {
    font-size: 0.8125rem;
    color: var(--text-faint);
    letter-spacing: 0.08em;
  }

  /* 章节内容 */
  .chapter-content {
    padding-bottom: 4rem;
    font-family: "Noto Serif SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", serif;
    line-height: 2;
  }

  .chapter-content p {
    margin-bottom: 1.75rem;
    text-indent: 2em;
    line-height: inherit;
    transition: opacity 0.3s ease;
  }

  .container-narrow { max-width: 520px; margin: 0 auto; padding: 0 2rem; }
  .container-wide { max-width: 860px; margin: 0 auto; padding: 0 2rem; }

  /* 章节导航 */
  .chapter-nav {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 2rem 0;
    border-top: 1.5px solid var(--border-color);
    border-bottom: 1.5px solid var(--border-color);
    margin-bottom: 3rem;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.875rem;
    font-weight: 500;
    transition: all 0.3s ease;
    padding: 0.5rem 0;
  }

  .nav-link:hover { color: var(--accent-light); text-shadow: 0 0 8px var(--accent-glow); }
  .nav-link.disabled { color: var(--text-faint); cursor: default; pointer-events: none; }
  .chapter-nav .center { color: var(--text-faint); font-size: 0.8125rem; letter-spacing: 0.1em; }

  /* 评论区 */
  .comments-section { margin-bottom: 4rem; }

  .comments-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 1.5rem;
  }

  .comments-section h3 {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    font-size: 1.125rem;
    font-weight: 600;
    color: var(--text-primary);
  }

  .comments-count {
    font-size: 0.75rem;
    color: var(--text-faint);
    letter-spacing: 0.05em;
  }

  .comment-form { margin-bottom: 2rem; }
  .comment-form textarea { margin-bottom: 0.75rem; }

  .comment-form-actions {
    display: flex;
    justify-content: flex-end;
  }

  .comments-list { display: flex; flex-direction: column; gap: 0.75rem; }

  .comment-item {
    padding: 1.25rem 1.5rem;
    background: var(--bg-card);
    border: 1.5px solid var(--border-color);
    border-radius: var(--radius);
    transition: all 0.3s ease;
    animation: fadeInUp 0.4s ease-out both;
  }

  .comment-item:hover { border-color: var(--border-hover); box-shadow: 0 2px 12px rgba(0, 0, 0, 0.08); }

  .comment-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-bottom: 0.75rem;
  }

  .comment-author-info {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }

  .comment-author {
    font-size: 0.875rem;
    font-weight: 600;
    color: var(--accent-light);
  }

  .comment-time { font-size: 0.75rem; color: var(--text-faint); letter-spacing: 0.02em; }

  .comment-delete {
    background: none;
    border: 1px solid transparent;
    color: var(--text-faint);
    font-size: 0.75rem;
    cursor: pointer;
    padding: 0.375rem 0.625rem;
    transition: all 0.25s ease;
    border-radius: 6px;
    font-family: inherit;
  }

  .comment-delete:hover { color: var(--error); background: var(--error-bg); border-color: rgba(239, 68, 68, 0.15); }

  .comment-body {
    font-size: 0.9375rem;
    color: var(--text-secondary);
    line-height: 1.7;
  }

  /* Footer */
  footer {
    padding: 3rem 0;
    text-align: center;
  }

  .footer-line {
    height: 1px;
    background: linear-gradient(90deg, transparent, var(--border-color), transparent);
    margin-bottom: 2rem;
  }

  footer p {
    font-size: 0.75rem;
    color: var(--text-faint);
    letter-spacing: 0.08em;
  }

  @keyframes shimmer {
    0% { background-position: -200% 0; }
    100% { background-position: 200% 0; }
  }

  @media (max-width: 640px) {
    .reader-toolbar { gap: 0.875rem; font-size: 0.75rem; padding: 1rem 0; }
    .toolbar-divider { display: none; }
    .bookmark-label { display: none; }
    .container-reader, .container-narrow, .container-wide { padding: 0 1.25rem; }
    .chapter-header h1 { font-size: 1.5rem; }
    .chapter-meta-label { font-size: 0.6875rem; }
    .nav-link { font-size: 0.8125rem; }
  }
</style>
