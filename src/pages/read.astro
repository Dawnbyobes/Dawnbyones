---
const chapterId = Astro.url.searchParams.get('id');
---

<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>阅读 - 冰箱里的世界</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }

      body {
        font-family: "Noto Serif SC", "PingFang SC", "Hiragino Sans GB", "Microsoft YaHei", serif;
        background: #0a0a0a;
        color: #ccc;
        line-height: 2;
        font-size: 1.125rem;
      }

      .container {
        max-width: 680px;
        margin: 0 auto;
        padding: 0 2rem;
      }

      header {
        padding: 1.5rem 0;
        display: flex;
        justify-content: space-between;
        align-items: center;
        position: sticky;
        top: 0;
        background: #0a0a0a;
        border-bottom: 1px solid #111;
        z-index: 10;
      }

      .logo {
        font-size: 0.875rem;
        font-weight: 500;
        color: #fff;
        text-decoration: none;
        letter-spacing: 0.05em;
      }

      .nav a {
        color: #555;
        text-decoration: none;
        margin-left: 1.5rem;
        font-size: 0.875rem;
        transition: color 0.2s;
        cursor: pointer;
      }

      .nav a:hover { color: #fff; }

      /* 阅读设置栏 */
      .reader-settings {
        display: flex;
        gap: 2rem;
        padding: 1rem 0;
        border-bottom: 1px solid #111;
        margin-bottom: 2rem;
        font-family: "PingFang SC", sans-serif;
        font-size: 0.8125rem;
        color: #555;
      }

      .setting-group {
        display: flex;
        align-items: center;
        gap: 0.75rem;
      }

      .setting-group label { color: #666; }

      .setting-group button {
        background: #1a1a1a;
        border: 1px solid #333;
        color: #888;
        padding: 0.25rem 0.75rem;
        border-radius: 4px;
        cursor: pointer;
        font-size: 0.8125rem;
        transition: all 0.2s;
      }

      .setting-group button:hover {
        border-color: #555;
        color: #fff;
      }

      .chapter-header {
        padding: 2rem 0 3rem;
        text-align: center;
        border-bottom: 1px solid #111;
        margin-bottom: 3rem;
      }

      .chapter-header h1 {
        font-size: 1.5rem;
        font-weight: 600;
        color: #fff;
        margin-bottom: 0.5rem;
      }

      .chapter-header .meta {
        font-size: 0.75rem;
        color: #444;
        font-family: "PingFang SC", sans-serif;
      }

      .chapter-content {
        padding-bottom: 4rem;
        white-space: pre-wrap;
        word-wrap: break-word;
      }

      .chapter-content p {
        margin-bottom: 1.5rem;
        text-indent: 2em;
      }

      .chapter-nav {
        display: flex;
        justify-content: space-between;
        align-items: center;
        padding: 2rem 0;
        border-top: 1px solid #111;
        border-bottom: 1px solid #111;
        margin-bottom: 4rem;
      }

      .chapter-nav a {
        color: #555;
        text-decoration: none;
        font-size: 0.875rem;
        font-family: "PingFang SC", sans-serif;
        transition: color 0.2s;
        padding: 0.5rem 0;
      }

      .chapter-nav a:hover { color: #fff; }

      .chapter-nav a.disabled {
        color: #222;
        cursor: default;
        pointer-events: none;
      }

      .chapter-nav .center {
        color: #444;
        font-size: 0.75rem;
      }

      footer {
        padding: 3rem 0;
        text-align: center;
        font-size: 0.75rem;
        color: #222;
        border-top: 1px solid #111;
      }
    </style>
  </head>
  <body>
    <header class="container">
      <a href="/" class="logo">冰箱里的世界</a>
      <nav class="nav">
        <a href="/novels">目录</a>
        <a onclick="logout()">退出</a>
      </nav>
    </header>

    <main class="container">
      <div class="reader-settings">
        <div class="setting-group">
          <label>字号</label>
          <button onclick="changeFontSize(-1)">小</button>
          <button onclick="changeFontSize(1)">大</button>
        </div>
        <div class="setting-group">
          <label>行距</label>
          <button onclick="changeLineHeight(-0.2)">窄</button>
          <button onclick="changeLineHeight(0.2)">宽</button>
        </div>
      </div>

      <div class="chapter-header">
        <h1 id="title">加载中</h1>
        <div class="meta" id="meta"></div>
      </div>

      <div class="chapter-content" id="content"></div>

      <div class="chapter-nav" id="chapterNav">
        <a href="#" id="prevLink">上一章</a>
        <span class="center" id="progress"></span>
        <a href="#" id="nextLink">下一章</a>
      </div>
    </main>

    <footer class="container">
      <p>2026 冰箱里的世界 · 仅供会员阅读</p>
    </footer>

    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.39.0';

      const SUPABASE_URL = 'https://cwkqlwdeteitisdrlwmg.supabase.co';
      const SUPABASE_KEY = 'eyJhbGciOiJIUzI1NiIsInR5cCI6IkpXVCJ9.eyJpc3MiOiJzdXBhYmFzZSIsInJlZiI6ImN3a3Fsd2RldGVpdGlzZHJsd21nIiwicm9sZSI6ImFub24iLCJpYXQiOjE3ODEyODkwMzMsImV4cCI6MjA5Njg2NTAzM30.hSbK_Z1rH9pXUwpfh2o5ZxbpkRUyy_7xDYcrmvLXgq8';
      const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);

      const token = localStorage.getItem('sb_token');
      if (!token) {
        window.location.href = '/login';
      }

      let readerId = localStorage.getItem('reader_id');
      if (!readerId) {
        readerId = '读者#' + Math.floor(1000 + Math.random() * 9000);
        localStorage.setItem('reader_id', readerId);
      }

      const currentId = new URLSearchParams(window.location.search).get('id');
      if (!currentId) {
        window.location.href = '/novels';
      }

      let allChapters = [];

      let fontSize = parseFloat(localStorage.getItem('reader_font_size')) || 1.125;
      let lineHeight = parseFloat(localStorage.getItem('reader_line_height')) || 2;

      function applySettings() {
        const content = document.getElementById('content');
        if (content) {
          content.style.fontSize = fontSize + 'rem';
          content.style.lineHeight = lineHeight;
        }
      }

      window.changeFontSize = function(delta) {
        fontSize = Math.max(0.875, Math.min(1.5, fontSize + delta * 0.125));
        localStorage.setItem('reader_font_size', fontSize);
        applySettings();
      };

      window.changeLineHeight = function(delta) {
        lineHeight = Math.max(1.5, Math.min(3, lineHeight + delta));
        localStorage.setItem('reader_line_height', lineHeight);
        applySettings();
      };

      async function loadChapter() {
        localStorage.setItem('last_read_chapter', currentId);

        const { data: chapters } = await supabase
          .from('chapters')
          .select('id, order_num, title')
          .order('order_num', { ascending: true });

        allChapters = chapters || [];
        const currentIndex = allChapters.findIndex(c => c.id === currentId);

        const { data: chapter } = await supabase
          .from('chapters')
          .select('*')
          .eq('id', currentId)
          .single();

        if (!chapter) {
          document.getElementById('title').textContent = '章节不存在';
          return;
        }

        document.getElementById('title').textContent = `第${chapter.order_num}章 ${chapter.title}`;
        document.getElementById('meta').textContent = new Date(chapter.created_at).toLocaleDateString('zh-CN');

        const paragraphs = chapter.content.split('\n').filter(p => p.trim());
        document.getElementById('content').innerHTML = paragraphs.map(p => `<p>${p}</p>`).join('');

        applySettings();

        const prevLink = document.getElementById('prevLink');
        const nextLink = document.getElementById('nextLink');

        if (currentIndex > 0) {
          prevLink.href = `/read?id=${allChapters[currentIndex - 1].id}`;
          prevLink.classList.remove('disabled');
        } else {
          prevLink.classList.add('disabled');
          prevLink.textContent = '已是第一章';
        }

        if (currentIndex < allChapters.length - 1) {
          nextLink.href = `/read?id=${allChapters[currentIndex + 1].id}`;
          nextLink.classList.remove('disabled');
        } else {
          nextLink.classList.add('disabled');
          nextLink.textContent = '已是最后一章';
        }

        document.getElementById('progress').textContent = `${currentIndex + 1} / ${allChapters.length}`;
      }

      window.logout = function() {
        localStorage.removeItem('sb_token');
        window.location.href = '/';
      };

      loadChapter();
    </script>
  </body>
</html>