<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>登录 - 冰箱里的世界</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      
      body {
        font-family: "SF Mono", "Fira Code", "JetBrains Mono", "Courier New", monospace;
        background: #0a0a0a;
        color: #e0e0e0;
        min-height: 100vh;
        display: flex;
        align-items: center;
        justify-content: center;
      }
      
      .box {
        width: 100%;
        max-width: 400px;
        padding: 2rem;
      }
      
      .back {
        margin-bottom: 2rem;
      }
      
      .back a {
        color: #555;
        text-decoration: none;
        font-size: 0.8125rem;
        transition: color 0.2s;
      }
      
      .back a:hover {
        color: #fff;
      }
      
      h1 {
        font-size: 1.25rem;
        font-weight: 400;
        color: #fff;
        margin-bottom: 2rem;
      }
      
      h1::before {
        content: ">";
        color: #fff;
        margin-right: 0.5rem;
      }
      
      input {
        width: 100%;
        padding: 0.875rem 1rem;
        margin-bottom: 1rem;
        background: #111;
        border: 1px solid #222;
        color: #e0e0e0;
        font-family: inherit;
        font-size: 0.875rem;
        outline: none;
        transition: border-color 0.2s;
      }
      
      input:focus {
        border-color: #444;
      }
      
      input::placeholder {
        color: #444;
      }
      
      button {
        width: 100%;
        padding: 0.875rem;
        background: #fff;
        color: #0a0a0a;
        border: none;
        font-family: inherit;
        font-size: 0.875rem;
        cursor: pointer;
        transition: opacity 0.2s;
      }
      
      button:hover:not(:disabled) {
        opacity: 0.9;
      }
      
      button:disabled {
        background: #222;
        color: #555;
        cursor: not-allowed;
      }
      
      .links {
        margin-top: 1.5rem;
        display: flex;
        justify-content: space-between;
      }
      
      .links a {
        color: #555;
        text-decoration: none;
        font-size: 0.8125rem;
        transition: color 0.2s;
      }
      
      .links a:hover {
        color: #fff;
      }
      
      .message {
        margin-top: 1.5rem;
        font-size: 0.8125rem;
      }
      
      .error { color: #c00; }
      .success { color: #0a0; }
    </style>
  </head>
