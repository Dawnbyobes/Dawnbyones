<!DOCTYPE html>
<html lang="zh-CN">
  <head>
    <meta charset="utf-8" />
    <title>登录 - 冰箱里的世界</title>
    <style>
      * { margin: 0; padding: 0; box-sizing: border-box; }
      body { 
        font-family: system-ui, sans-serif;
        background: #faf9f7;
        display: flex;
        justify-content: center;
        align-items: center;
        min-height: 100vh;
      }
      .box {
        background: #fff;
        padding: 2.5rem;
        border-radius: 12px;
        box-shadow: 0 2px 8px rgba(0,0,0,0.1);
        width: 100%;
        max-width: 400px;
      }
      h1 { margin-bottom: 1.5rem; text-align: center; font-size: 1.5rem; }
      input {
        width: 100%;
        padding: 0.75rem;
        margin-bottom: 1rem;
        border: 1px solid #ddd;
        border-radius: 6px;
        font-size: 1rem;
      }
      button {
        width: 100%;
        padding: 0.75rem;
        background: #1a1a1a;
        color: #fff;
        border: none;
        border-radius: 6px;
        font-size: 1rem;
        cursor: pointer;
      }
      button:disabled { background: #999; }
      .error { color: #c00; margin-top: 1rem; text-align: center; font-size: 0.875rem; }
      .success { color: #0a0; margin-top: 1rem; text-align: center; font-size: 0.875rem; }
      .back { text-align: center; margin-top: 1.5rem; }
      .back a { color: #666; text-decoration: none; margin: 0 0.5rem; }
      .back a:hover { text-decoration: underline; }
    </style>
  </head>
  <body>
    <div class="box">
      <h1>🔐 会员登录</h1>
      <form id="loginForm">
        <input type="email" id="email" placeholder="邮箱" required />
        <input type="password" id="password" placeholder="密码" required />
        <button type="submit" id="submitBtn">登录</button>
      </form>
      <div id="message"></div>
      <div class="back">
        <a href="/">← 首页</a>
        <a href="/register">注册账号</a>
      </div>
    </div>
    
    <script type="module">
      import { createClient } from 'https://esm.sh/@supabase/supabase-js@2.39.0';
      
      const SUPABASE_URL = 'https://cwkqlwdeteitisdrlwmg.supabase.co';
      const SUPABASE_KEY = 'sb_publishable_qypuFxvUtu1ZfIC1w8FtDw_Ue0viR85';
      const supabase = createClient(SUPABASE_URL, SUPABASE_KEY);
      
      const form = document.getElementById('loginForm');
      const msg = document.getElementById('message');
      const btn = document.getElementById('submitBtn');
      
      form.addEventListener('submit', async (e) => {
        e.preventDefault();
        btn.disabled = true;
        btn.textContent = '登录中...';
        
        const email = document.getElementById('email').value.trim();
        const password = document.getElementById('password').value;
        
        try {
          const { data, error } = await supabase.auth.signInWithPassword({
            email,
            password
          });
          
          if (error) {
            msg.innerHTML = `<p class="error">❌ ${error.message}</p>`;
            btn.disabled = false;
            btn.textContent = '登录';
            return;
          }
          
          localStorage.setItem('sb_token', data.session.access_token);
          
          msg.innerHTML = '<p class="success">✅ 登录成功！正在跳转...</p>';
          setTimeout(() => window.location.href = '/novels', 1000);
          
        } catch (err) {
          msg.innerHTML = '<p class="error">❌ 网络错误，请重试</p>';
          btn.disabled = false;
          btn.textContent = '登录';
        }
      });
    </script>
  </body>
</html>