---
import Layout from '../layouts/Layout.astro';
---

<Layout title="重置密码 - 冰箱里的世界">
  <div class="auth-page">
    <div class="auth-glow"></div>
    <div class="auth-box">
      <a href="/login" class="back-link">&larr; 返回登录</a>
      <h1>重置密码</h1>
      <p class="subtitle">输入你的新密码</p>

      <form id="resetForm">
        <input type="password" id="newPassword" placeholder="新密码（至少6位）" required minlength="6" autocomplete="new-password" />
        <input type="password" id="confirmPassword" placeholder="确认新密码" required minlength="6" autocomplete="new-password" />
        <button type="submit" class="btn btn-primary" id="submitBtn">更新密码</button>
      </form>
      <div class="message" id="message"></div>
    </div>
  </div>
</Layout>

<script type="module">
  import { updatePassword } from '/lib/supabase.js';

  const form = document.getElementById('resetForm');
  const msg = document.getElementById('message');
  const btn = document.getElementById('submitBtn');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = '更新中...';
    msg.innerHTML = '';
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    if (newPassword !== confirmPassword) {
      msg.innerHTML = '<p class="error">两次输入的密码不一致</p>';
      btn.disabled = false;
      btn.textContent = '更新密码';
      return;
    }
    const { error } = await updatePassword(newPassword);
    if (error) { msg.innerHTML = `<p class="error">${error.message}</p>`; btn.disabled = false; btn.textContent = '更新密码'; return; }
    msg.innerHTML = '<p class="success">密码更新成功！正在跳转到登录页...</p>';
    setTimeout(() => window.location.href = '/login', 1500);
  });
</script>

<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }
  .auth-glow {
    position: absolute;
    top: 30%;
    left: 50%;
    transform: translate(-50%, -50%);
    width: 500px;
    height: 500px;
    background: radial-gradient(circle, rgba(124, 58, 237, 0.1) 0%, rgba(6, 182, 212, 0.04) 40%, transparent 65%);
    pointer-events: none;
  }
  .auth-box {
    width: 100%;
    max-width: 400px;
    padding: 2rem;
    position: relative;
    z-index: 1;
  }
  .back-link {
    display: inline-block;
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.875rem;
    margin-bottom: 3rem;
    transition: all 0.25s;
  }
  .back-link:hover {
    color: var(--accent-light);
    text-shadow: 0 0 8px var(--accent-glow);
  }
  h1 {
    font-size: 1.5rem;
    font-weight: 600;
    color: var(--text-primary);
    margin-bottom: 0.5rem;
  }
  .subtitle {
    font-size: 0.875rem;
    color: var(--text-muted);
    margin-bottom: 2.5rem;
  }
  input { margin-bottom: 0.875rem; }
</style>
