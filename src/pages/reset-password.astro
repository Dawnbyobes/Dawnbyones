---
import Layout from '../layouts/Layout.astro';
---

<Layout title="重置密码">
  <div class="auth-page">
    <div class="auth-box">
      <a href="/login" class="back-link">返回登录</a>
      <h1>重置密码</h1>
      <p class="subtitle">设置新密码</p>

      <form id="resetForm">
        <input type="password" id="newPassword" placeholder="新密码（至少6位）" required minlength="6" autocomplete="new-password" />
        <input type="password" id="confirmPassword" placeholder="确认新密码" required minlength="6" autocomplete="new-password" />
        <button type="submit" class="btn btn-primary" id="submitBtn">更新密码</button>
      </form>

      <div class="message" id="message"></div>
    </div>
  </div>
</Layout>

<script type="module">
  import { updatePassword } from '/lib/supabase.js';

  const form = document.getElementById('resetForm');
  const msg = document.getElementById('message');
  const btn = document.getElementById('submitBtn');

  form.addEventListener('submit', async (e) => {
    e.preventDefault();
    btn.disabled = true;
    btn.textContent = '更新中...';
    msg.innerHTML = '';
    const newPassword = document.getElementById('newPassword').value;
    const confirmPassword = document.getElementById('confirmPassword').value;
    if (newPassword !== confirmPassword) {
      msg.innerHTML = '<p class="error">两次输入不一致</p>';
      btn.disabled = false;
      btn.textContent = '更新密码';
      return;
    }
    const { error } = await updatePassword(newPassword);
    if (error) { msg.innerHTML = `<p class="error">${error.message}</p>`; btn.disabled = false; btn.textContent = '更新密码'; return; }
    msg.innerHTML = '<p class="success">密码已更新，正在跳转...</p>';
    setTimeout(() => window.location.href = '/login', 1200);
  });
</script>

<style>
  .auth-page {
    min-height: 100vh;
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 24px;
  }
  .auth-box {
    width: 100%;
    max-width: 360px;
  }
  .back-link {
    display: block;
    color: var(--text-tertiary);
    text-decoration: none;
    font-size: 13px;
    margin-bottom: 40px;
    transition: color 0.2s;
  }
  .back-link:hover { color: var(--text); }
  h1 {
    font-size: 22px;
    font-weight: 600;
    margin-bottom: 4px;
    letter-spacing: -0.01em;
  }
  .subtitle {
    font-size: 14px;
    color: var(--text-secondary);
    margin-bottom: 32px;
  }
  form input {
    margin-bottom: 10px;
  }
  form .btn {
    width: 100%;
    margin-top: 6px;
  }
</style>
