---
// ReaderHeader 组件 - 阅读页面专用头部
// 包含目录导航、主题切换、退出登录
---

<header class="reader-header">
  <div class="reader-header-inner">
    <a href="/" class="logo">冰箱里的世界</a>
    <nav class="reader-nav">
      <a href="/novels">目录</a>
      <button class="theme-toggle" id="themeToggle" title="切换主题">
        <span id="themeIcon">◐</span>
      </button>
      <a href="#" data-logout>退出</a>
    </nav>
  </div>
</header>

<script>
  // 退出登录
  document.querySelectorAll('[data-logout]').forEach(el => {
    el.addEventListener('click', async (e) => {
      e.preventDefault();
      const { signOut } = await import('/src/lib/supabase.js');
      await signOut();
      window.location.href = '/';
    });
  });

  // 主题切换
  const themeToggle = document.getElementById('themeToggle');
  const themeIcon = document.getElementById('themeIcon');
  const themes = ['dark', 'light', 'sepia'];
  const themeIcons = ['◐', '◑', '◒'];
  
  function updateThemeIcon() {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    const index = themes.indexOf(currentTheme);
    themeIcon.textContent = themeIcons[index] || themeIcons[0];
  }
  
  themeToggle?.addEventListener('click', async () => {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    const currentIndex = themes.indexOf(currentTheme);
    const nextIndex = (currentIndex + 1) % themes.length;
    const nextTheme = themes[nextIndex];
    
    const { setTheme } = await import('/src/lib/supabase.js');
    setTheme(nextTheme);
    updateThemeIcon();
  });
  
  updateThemeIcon();
</script>

<style>
  .reader-header {
    padding: 1rem 0;
    position: sticky;
    top: 0;
    background: var(--bg-primary);
    border-bottom: 1px solid var(--border-color);
    z-index: 10;
    transition: background-color var(--transition);
  }
  
  .reader-header-inner {
    max-width: 680px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  
  @media (max-width: 640px) {
    .reader-header-inner {
      padding: 0 1rem;
    }
  }
  
  .logo {
    font-size: 0.875rem;
    font-weight: 500;
    color: var(--text-primary);
    text-decoration: none;
    letter-spacing: 0.05em;
  }
  
  .reader-nav {
    display: flex;
    align-items: center;
    gap: 1.5rem;
  }
  
  .reader-nav a {
    color: var(--text-dim);
    text-decoration: none;
    font-size: 0.875rem;
    transition: color 0.2s;
    cursor: pointer;
    background: none;
    border: none;
    font-family: inherit;
    padding: 0;
  }
  
  .reader-nav a:hover {
    color: var(--text-primary);
  }
  
  .theme-toggle {
    background: none;
    border: 1px solid var(--border-hover);
    color: var(--text-muted);
    width: 32px;
    height: 32px;
    border-radius: 50%;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 0.875rem;
    transition: all var(--transition);
  }
  
  .theme-toggle:hover {
    border-color: var(--text-dim);
    color: var(--text-primary);
  }
</style>
