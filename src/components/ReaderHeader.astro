---
---

<header class="reader-header">
  <div class="reader-header-inner container-reader">
    <a href="/" class="site-title">冰箱里的世界</a>
    <nav class="reader-nav">
      <a href="/novels">目录</a>
      <button class="theme-btn" id="themeToggle">主题</button>
      <a href="#" data-logout>退出</a>
    </nav>
  </div>
</header>

<script>
  document.querySelector('[data-logout]')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const { signOut } = await import('/src/lib/supabase.js');
    await signOut();
    window.location.href = '/';
  });

  const themeToggle = document.getElementById('themeToggle');
  const themes = ['dark', 'light', 'sepia'];

  themeToggle?.addEventListener('click', async () => {
    const currentTheme = document.documentElement.getAttribute('data-theme') || 'dark';
    const currentIndex = themes.indexOf(currentTheme);
    const nextTheme = themes[(currentIndex + 1) % themes.length];
    const { setTheme } = await import('/src/lib/supabase.js');
    setTheme(nextTheme);
  });
</script>

<style>
  .reader-header {
    position: sticky;
    top: 0;
    background: rgba(10, 10, 10, 0.92);
    backdrop-filter: blur(12px);
    border-bottom: 1px solid var(--border);
    z-index: 10;
    padding: 12px 0;
  }
  [data-theme="light"] .reader-header {
    background: rgba(250, 250, 250, 0.92);
  }
  [data-theme="sepia"] .reader-header {
    background: rgba(245, 237, 214, 0.92);
  }
  .reader-header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .site-title {
    font-size: 14px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
  }
  .site-title:hover { color: var(--accent); }
  .reader-nav {
    display: flex;
    align-items: center;
    gap: 20px;
  }
  .reader-nav a {
    font-size: 13px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }
  .reader-nav a:hover { color: var(--text); }
  .theme-btn {
    background: none;
    border: none;
    color: var(--text-secondary);
    font-size: 13px;
    font-family: inherit;
    cursor: pointer;
    padding: 0;
    transition: color 0.2s;
  }
  .theme-btn:hover { color: var(--text); }
</style>
