---
// Header 组件 v2 - 精致玻璃态导航

interface Props {
  mode?: 'public' | 'private';
  title?: string;
}

const { mode = 'private', title = '冰箱里的世界' } = Astro.props;
---

<header class="header-container">
  <div class="header-inner">
    <a href="/" class="logo">
      <span class="logo-icon">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
          <path d="M12 2L2 7l10 5 10-5-10-5z"/>
          <path d="M2 17l10 5 10-5"/>
          <path d="M2 12l10 5 10-5"/>
        </svg>
      </span>
      <span class="logo-text">{title}</span>
    </a>
    <nav class="nav">
      {mode === 'public' ? (
        <>
          <a href="/register" class="nav-link">邀请码注册</a>
          <a href="/login" class="nav-link nav-highlight">会员登录</a>
        </>
      ) : (
        <>
          <a href="/novels" class="nav-link">目录</a>
          <a href="/profile" class="nav-link">个人中心</a>
          <a href="#" class="nav-link" data-logout>退出</a>
        </>
      )}
    </nav>
  </div>
</header>

<script>
  document.querySelectorAll('[data-logout]').forEach(el => {
    el.addEventListener('click', async (e) => {
      e.preventDefault();
      const { signOut } = await import('/src/lib/supabase.js');
      await signOut();
      window.location.href = '/';
    });
  });
</script>

<style>
  .header-container {
    padding: 1.25rem 0;
    border-bottom: 1px solid var(--border-color);
    background: linear-gradient(180deg, rgba(3,3,8,0.95) 0%, rgba(3,3,8,0.85) 100%);
    backdrop-filter: blur(20px) saturate(1.2);
    -webkit-backdrop-filter: blur(20px) saturate(1.2);
    position: sticky;
    top: 0;
    z-index: 100;
  }

  .header-inner {
    max-width: 720px;
    margin: 0 auto;
    padding: 0 2rem;
    display: flex;
    justify-content: space-between;
    align-items: center;
  }

  @media (max-width: 640px) {
    .header-inner { padding: 0 1.25rem; }
  }

  .logo {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    text-decoration: none;
    transition: all 0.3s ease;
  }

  .logo:hover {
    transform: translateY(-1px);
  }

  .logo-icon {
    display: flex;
    align-items: center;
    justify-content: center;
    width: 32px;
    height: 32px;
    background: linear-gradient(135deg, var(--accent) 0%, var(--accent-dim) 100%);
    border-radius: 10px;
    color: #fff;
    box-shadow: 0 2px 10px var(--accent-glow);
  }

  .logo-icon svg {
    width: 18px;
    height: 18px;
  }

  .logo-text {
    font-size: 0.9375rem;
    font-weight: 600;
    background: linear-gradient(135deg, var(--text-primary) 0%, var(--accent-light) 100%);
    -webkit-background-clip: text;
    -webkit-text-fill-color: transparent;
    background-clip: text;
    letter-spacing: 0.04em;
  }

  .nav {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .nav-link {
    color: var(--text-muted);
    text-decoration: none;
    font-size: 0.8125rem;
    font-weight: 400;
    transition: all 0.3s ease;
    cursor: pointer;
    background: none;
    border: none;
    font-family: inherit;
    padding: 0.5rem 0.875rem;
    border-radius: 8px;
    letter-spacing: 0.02em;
    position: relative;
  }

  .nav-link:hover {
    color: var(--accent-light);
    background: var(--accent-pale);
  }

  .nav-link::after {
    content: '';
    position: absolute;
    bottom: 0.25rem;
    left: 50%;
    transform: translateX(-50%) scaleX(0);
    width: 60%;
    height: 2px;
    background: linear-gradient(90deg, transparent, var(--accent-light), transparent);
    border-radius: 2px;
    transition: transform 0.3s ease;
  }

  .nav-link:hover::after {
    transform: translateX(-50%) scaleX(1);
  }

  .nav-highlight {
    padding: 0.5rem 1.125rem !important;
    border: 1.5px solid var(--accent-dim) !important;
    border-radius: 10px !important;
    color: var(--accent-light) !important;
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.08) 0%, rgba(91, 33, 182, 0.04) 100%) !important;
  }

  .nav-highlight:hover {
    background: linear-gradient(135deg, rgba(124, 58, 237, 0.15) 0%, rgba(91, 33, 182, 0.08) 100%) !important;
    box-shadow: 0 0 20px var(--accent-glow) !important;
    border-color: var(--accent) !important;
  }

  .nav-highlight::after {
    display: none;
  }
</style>
