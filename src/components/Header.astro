---
interface Props {
  mode?: 'public' | 'private';
}

const { mode = 'private' } = Astro.props;
---

<header class="site-header">
  <div class="header-inner container">
    <a href="/" class="site-title">冰箱里的世界</a>
    <nav class="nav">
      {mode === 'public' ? (
        <>
          <a href="/register">注册</a>
          <a href="/login">登录</a>
        </>
      ) : (
        <>
          <a href="/novels">目录</a>
          <a href="/profile">设置</a>
          <a href="#" data-logout>退出</a>
        </>
      )}
    </nav>
  </div>
</header>

<script>
  document.querySelector('[data-logout]')?.addEventListener('click', async (e) => {
    e.preventDefault();
    const { signOut } = await import('/src/lib/supabase.js');
    await signOut();
    window.location.href = '/';
  });
</script>

<style>
  .site-header {
    border-bottom: 1px solid var(--border);
    padding: 16px 0;
  }
  .header-inner {
    display: flex;
    justify-content: space-between;
    align-items: center;
  }
  .site-title {
    font-size: 15px;
    font-weight: 500;
    color: var(--text);
    text-decoration: none;
    letter-spacing: 0.02em;
  }
  .site-title:hover { color: var(--accent); }
  .nav {
    display: flex;
    align-items: center;
    gap: 24px;
  }
  .nav a {
    font-size: 14px;
    color: var(--text-secondary);
    text-decoration: none;
    transition: color 0.2s;
  }
  .nav a:hover { color: var(--text); }
  @media (max-width: 640px) {
    .nav { gap: 16px; }
    .nav a { font-size: 13px; }
  }
</style>
